<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataBuild.Sql\DbDataBuild.Sql.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Models\DbDataBuild.Models.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Core\DbDataBuild.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient 7.1.1 brings 9.0.18, which has advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); a direct reference takes precedence until SqlClient moves -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="$(DbDataKitRoot)build/DuckDb.Native.targets" />
</Project>
