<Project>
  <!-- the settings shared by every product -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- a single-file publish is a deliverable: code that breaks inside one (Assembly.Location, for example) fails the build -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Monorepo layout: DbDataBuild/ and DbDataKit/ (the shared libraries) are sibling folders at the repository root. -->
    <DbDataKitRoot Condition="'$(DbDataKitRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'DbDataKit'))</DbDataKitRoot>
    <DbDataKitRoot>$([MSBuild]::EnsureTrailingSlash('$(DbDataKitRoot)'))</DbDataKitRoot>
    <UseLocalDbDataKit Condition="'$(UseLocalDbDataKit)' == '' and Exists('$(DbDataKitRoot)src')">true</UseLocalDbDataKit>
    <DbDataKitVersion Condition="'$(DbDataKitVersion)' == ''">0.1.0</DbDataKitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- the version of a development build; a release stamps the real one, CalVer, from the release workflow (VERSION=... in scripts/publish.sh) -->
    <Version>0.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Dan Shryock</Authors>
    <Copyright>Copyright (c) 2026 Dan Shryock</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DbDataSync/DbDataKit</RepositoryUrl>
  </PropertyGroup>
</Project>
