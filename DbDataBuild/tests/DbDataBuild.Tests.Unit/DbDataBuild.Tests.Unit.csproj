<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- a shared DbDataKit library, through the mechanism in Directory.Build.targets (plan 13, F08) -->
    <DbDataKitReference Include="Dialect.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="LibGit2Sharp" />   <!-- a remote project for the server tests; plan 13, R02 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- the stand-in git server that requires a login, shared with the library's tests; plan 13, W12 -->
    <Compile Include="..\..\..\DbDataKit\tests\DbDataKit.Config.Git.Tests\AuthenticatedGitServer.cs" Link="AuthenticatedGitServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Tui\DbDataBuild.Tui.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Models\DbDataBuild.Models.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Cli\DbDataBuild.Cli.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Sql\DbDataBuild.Sql.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Targets.DuckDb\DbDataBuild.Targets.DuckDb.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Define\DbDataBuild.Define.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Targets\DbDataBuild.Targets.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.State\DbDataBuild.State.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Execution\DbDataBuild.Execution.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Planning\DbDataBuild.Planning.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Apply\DbDataBuild.Apply.csproj" />
    <ProjectReference Include="..\..\src\DbDataBuild.Lowering\DbDataBuild.Lowering.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Using Include="DbDataKit.Cli" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Schema" />   <!-- the structure model moved to the shared library; the types keep their names (plan 19, H02) -->
    <Using Include="DbDataKit.Schema.Planning" />
    <Using Include="DbDataKit.Transfer.IStatementLog" Alias="IStatementLog" />   <!-- the statement log is the shared gate's (plan 13, B06); the names stay -->
    <Using Include="DbDataKit.Transfer.StatementLogEntry" Alias="StatementLogEntry" />
    <Using Include="DbDataKit.Transfer.MemoryStatementLog" Alias="MemoryStatementLog" />
    <Using Include="DbDataKit.Transfer.FileStatementLog" Alias="FileStatementLog" />   <!-- the file log is the shared gate's too (plan 13, B07) -->
    <Using Include="DbDataKit.Schema.Ddl" />
    <Using Include="DbDataKit.Schema.Questions" />
  </ItemGroup>

</Project>
