<Project>
  <!--
    Shared DbDataKit.* libraries are declared in project files as <DbDataKitReference Include="Hosting.Certificates" /> (the package
    id without the DbDataKit. prefix), the same convention DbDataProxy and DbDataSync use. In local-source mode (UseLocalDbDataKit=true, on
    automatically in the monorepo, where DbDataKit/ sits next to this folder) each becomes a ProjectReference into the sibling
    DbDataKit/ folder; otherwise a PackageReference whose version is in Directory.Packages.props ($(DbDataKitVersion)).
  -->
  <ItemGroup Condition="'$(UseLocalDbDataKit)' != 'true'">
    <PackageReference Include="@(DbDataKitReference->'DbDataKit.%(Identity)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDbDataKit)' == 'true'">
    <ProjectReference Include="@(DbDataKitReference->'$(DbDataKitRoot)src\DbDataKit.%(Identity)\DbDataKit.%(Identity).csproj')" />
  </ItemGroup>
</Project>
