<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.Models\DbDataBuild.Models.csproj" />
    <ProjectReference Include="..\DbDataBuild.Sql\DbDataBuild.Sql.csproj" />
    <ProjectReference Include="..\DbDataBuild.Define\DbDataBuild.Define.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets\DbDataBuild.Targets.csproj" />
    <ProjectReference Include="..\DbDataBuild.State\DbDataBuild.State.csproj" />
    <ProjectReference Include="..\DbDataBuild.Execution\DbDataBuild.Execution.csproj" />
    <ProjectReference Include="..\DbDataBuild.Planning\DbDataBuild.Planning.csproj" />
    <ProjectReference Include="..\DbDataBuild.Apply\DbDataBuild.Apply.csproj" />
    <ProjectReference Include="..\DbDataBuild.Lowering\DbDataBuild.Lowering.csproj" />
    <ProjectReference Include="..\DbDataBuild.Sample\DbDataBuild.Sample.csproj" />
    <ProjectReference Include="..\DbDataBuild.Semantic\DbDataBuild.Semantic.csproj" />
    <ProjectReference Include="..\DbDataBuild.Tui\DbDataBuild.Tui.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets.DuckDb\DbDataBuild.Targets.DuckDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Catalog.Cache" />   <!-- the catalog cache of a draft: project import reads it offline; plan 33, SC20k -->
    <DbDataKitReference Include="Cli" />
    <DbDataKitReference Include="Monitoring" />
    <DbDataKitReference Include="Scheduling" />   <!-- the schedule a refresh plan declares, which a Runner package carries; plan 13, M08 -->
    <DbDataKitReference Include="State" />   <!-- the state database of a results directory; plan 23a FQ09 -->
    <DbDataKitReference Include="State.Engines" />   <!-- the state settings of a results directory (SQLite, SQL Server, PostgreSQL) -->
    <DbDataKitReference Include="Secrets.Abstractions" />   <!-- the references in a state connection string, resolved from the environment -->
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Connections.Abstractions" />
    <DbDataKitReference Include="Quality.Runner" />   <!-- the check evaluator, its run service and the quality state module: Build evaluates the checks of its models after a refresh; plan 23a, FQ09 -->
    <DbDataKitReference Include="Runner.Kit" />   <!-- the typed job surface: a refresh plan as a runner task; plan 28c, E01 -->
    <DbDataKitReference Include="Views" />   <!-- the loaders of dashboards and reports and their catalog check: project validate reads the dashboards/ and reports/ folders; plan 32, DBR29 -->
    <DbDataKitReference Include="Serving.Notify" />   <!-- the Gateway lineage client the contract guard asks; plan 21 CH06 -->
    <DbDataKitReference Include="Lineage" />   <!-- the lineage graph and the identity of a dataset; plan 18, G05 -->
    <DbDataKitReference Include="Semantic.Cli" />   <!-- the semantic verbs (describe, query, explain, members) over the shared Flight SQL client; plan 14a, SL22 -->
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AgentKit\SKILL.md" LogicalName="agentkit/SKILL.md" />
    <EmbeddedResource Include="Web\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\..\schemas\*.json" LogicalName="agentkit/schemas/%(Filename)%(Extension)" />
    <!-- project templates (DESIGN.md 15.7): templates/<name>/** is written out by `dbdatabuild project create <name>`; the dot files too -->
    <EmbeddedResource Include="..\..\templates\**\*" LogicalName="templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataBuild.Tests.Unit" />
    <InternalsVisibleTo Include="DbDataBuild.Tests.Conformance" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbdatabuild</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Cli" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Schema" />   <!-- the structure model moved to the shared library; the types keep their names (plan 19, H02) -->
    <Using Include="DbDataKit.Schema.Planning" />
    <Using Include="DbDataKit.Transfer.IStatementLog" Alias="IStatementLog" />   <!-- the statement log is the shared gate's (plan 13, B06); the names stay -->
    <Using Include="DbDataKit.Transfer.StatementLogEntry" Alias="StatementLogEntry" />
    <Using Include="DbDataKit.Transfer.MemoryStatementLog" Alias="MemoryStatementLog" />
    <Using Include="DbDataKit.Transfer.FileStatementLog" Alias="FileStatementLog" />   <!-- the file log is the shared gate's too (plan 13, B07) -->
    <Using Include="DbDataKit.Schema.Ddl" />
    <Using Include="DbDataKit.Schema.Questions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Tracking.Build" />   <!-- the tracking definition, streams, module and store moved to the shared library; the types keep their names (plan 28c, E16) -->
  </ItemGroup>

</Project>
