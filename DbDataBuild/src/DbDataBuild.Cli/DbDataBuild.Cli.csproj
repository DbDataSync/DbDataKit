<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.Models\DbDataBuild.Models.csproj" />
    <ProjectReference Include="..\DbDataBuild.Sql\DbDataBuild.Sql.csproj" />
    <ProjectReference Include="..\DbDataBuild.Define\DbDataBuild.Define.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets\DbDataBuild.Targets.csproj" />
    <ProjectReference Include="..\DbDataBuild.State\DbDataBuild.State.csproj" />
    <ProjectReference Include="..\DbDataBuild.Execution\DbDataBuild.Execution.csproj" />
    <ProjectReference Include="..\DbDataBuild.Planning\DbDataBuild.Planning.csproj" />
    <ProjectReference Include="..\DbDataBuild.Apply\DbDataBuild.Apply.csproj" />
    <ProjectReference Include="..\DbDataBuild.Lowering\DbDataBuild.Lowering.csproj" />
    <ProjectReference Include="..\DbDataBuild.Sample\DbDataBuild.Sample.csproj" />
    <ProjectReference Include="..\DbDataBuild.Tui\DbDataBuild.Tui.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets.DuckDb\DbDataBuild.Targets.DuckDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Cli" />
    <DbDataKitReference Include="Monitoring" />
    <DbDataKitReference Include="Scheduling" />   <!-- the schedule evaluator and the work queue the server runs plans from; plan 13, M08 -->
    <DbDataKitReference Include="State" />   <!-- the health rules (overdue, slow) every product shares; plan 13, M09 -->
    <DbDataKitReference Include="Web" />   <!-- the management API: pairing, tokens, roles; plan 13, R01 -->
    <DbDataKitReference Include="Hosting.Abstractions" />   <!-- the shared host: service and systemd modes, drain, /health and /version, limits; plan 13, R05 -->
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Secrets.Abstractions" />   <!-- the server's secret store and the logins it hands each command; plan 13, R04 -->
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Store" />
    <DbDataKitReference Include="Secrets.Cli" />
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Connections.Abstractions" />
    <DbDataKitReference Include="Lineage" />   <!-- the lineage graph and the identity of a dataset; plan 18, G05 -->
    <DbDataKitReference Include="Lineage.Cli" />   <!-- the lineage noun on the server command line; plan 18, G05 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AgentKit\SKILL.md" LogicalName="agentkit/SKILL.md" />
    <EmbeddedResource Include="Web\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\..\schemas\*.json" LogicalName="agentkit/schemas/%(Filename)%(Extension)" />
    <!-- project templates (DESIGN.md 15.7): templates/<name>/** is written out by `dbdatabuild project create <name>`; the dot files too -->
    <EmbeddedResource Include="..\..\templates\**\*" LogicalName="templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataBuild.Tests.Unit" />
    <InternalsVisibleTo Include="DbDataBuild.Tests.Conformance" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbdatabuild</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Cli" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Schema" />   <!-- the structure model moved to the shared library; the types keep their names (plan 19, H02) -->
    <Using Include="DbDataKit.Schema.Planning" />
    <Using Include="DbDataKit.Schema.Ddl" />
    <Using Include="DbDataKit.Schema.Questions" />
  </ItemGroup>

</Project>
