<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.State\DbDataBuild.State.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Connections.Abstractions" />   <!-- the login variable name every product shares, and the failure classifier; plan 13, B02, B03 -->
    <DbDataKitReference Include="Connections.Odbc" />   <!-- the ODBC failure mapper and the missing-prerequisite sentence -->
    <DbDataKitReference Include="Connections.SqlServer" />   <!-- the SQL Server failure mapper -->
    <DbDataKitReference Include="Metadata" />   <!-- the catalog readers of SQL Server and PostgreSQL, run through the read session; plan 13, B04 -->
    <DbDataKitReference Include="Connections.Postgres" />   <!-- the PostgreSQL failure mapper -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient 7.1.1 brings 9.0.18, which has advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); a direct reference takes precedence until SqlClient moves -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="DuckDB.NET.Data" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Data.Odbc" />
    <!-- the Flight SQL client (managed gRPC over Grpc.Net.Client; Apache.Arrow, Google.Protobuf and Grpc.Net.Client come with it): docs/research/read-origins.md, section 8b -->
    <PackageReference Include="Apache.Arrow.Flight.Sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataBuild.Tests.Unit" />
    <InternalsVisibleTo Include="DbDataBuild.Tests.Conformance" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="$(DbDataKitRoot)build/DuckDb.Native.targets" />
  <ItemGroup>
    <Using Include="DbDataKit.Schema" />   <!-- the structure model moved to the shared library; the types keep their names (plan 19, H02) -->
    <Using Include="DbDataKit.Schema.Planning" />
  </ItemGroup>

</Project>
