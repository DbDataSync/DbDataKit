<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.State\DbDataBuild.State.csproj" />
    <ProjectReference Include="..\DbDataBuild.Execution\DbDataBuild.Execution.csproj" />
    <ProjectReference Include="..\DbDataBuild.Planning\DbDataBuild.Planning.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets\DbDataBuild.Targets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataBuild.Tests.Unit" />
    <InternalsVisibleTo Include="DbDataBuild.Tests.Conformance" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="DbDataKit.Schema" />   <!-- the structure model moved to the shared library; the types keep their names (plan 19, H02) -->
    <Using Include="DbDataKit.Schema.Planning" />
    <Using Include="DbDataKit.Transfer.IStatementLog" Alias="IStatementLog" />   <!-- the statement log is the shared gate's (plan 13, B06); the names stay -->
    <Using Include="DbDataKit.Transfer.StatementLogEntry" Alias="StatementLogEntry" />
    <Using Include="DbDataKit.Transfer.MemoryStatementLog" Alias="MemoryStatementLog" />
  </ItemGroup>

</Project>
