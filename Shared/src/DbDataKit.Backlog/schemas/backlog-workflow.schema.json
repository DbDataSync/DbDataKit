{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbdatakit.dev/schemas/backlog-workflow-1.json",
  "title": "backlog-workflow/1",
  "description": "The workflow of a backlog (plan 27a BK01): its states, the state a new item starts in and the moves between states with the role that may make each.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "states", "initial", "transitions"],
  "properties": {
    "schema": { "const": "backlog-workflow/1" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "enum": ["todo", "doing", "done"] },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["assignee", "estimate", "resolution", "description", "sprint"] }
          }
        }
      }
    },
    "initial": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "role"],
        "properties": {
          "from": { "type": "string", "description": "A state id, or * for any state." },
          "to": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "role": { "enum": ["member", "lead"] }
        }
      }
    }
  }
}
