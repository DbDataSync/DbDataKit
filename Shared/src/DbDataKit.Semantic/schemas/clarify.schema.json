{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/qis/clarify.schema.json",
  "title": "Clarify",
  "description": "The agent asks one question instead of guessing, when a term maps to more than one catalog member.",
  "type": "object",
  "required": [
    "spec_version",
    "kind",
    "clarify"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "0.3"
    },
    "kind": {
      "const": "clarify"
    },
    "clarify": {
      "type": "object",
      "required": [
        "question",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "measure": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              },
              "attribute": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              }
            },
            "oneOf": [
              {
                "required": [
                  "measure"
                ]
              },
              {
                "required": [
                  "attribute"
                ]
              }
            ]
          }
        },
        "partial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measures": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              }
            },
            "attributes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              }
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
