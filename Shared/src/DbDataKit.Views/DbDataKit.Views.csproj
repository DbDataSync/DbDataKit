<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dashboards and reports (plan 32): the shared core of the dashboard/1 and report/1 documents (widgets, parameters, layouts, selectors), their strict loaders with file and line diagnostics, the pure selection of a layout, and the resolution of a layout into rendered widgets as the viewer.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- the schemas live with the shared visuals (web/visuals) and are embedded as they are; a test compares nothing because it is the same file -->
    <EmbeddedResource Include="..\..\web\visuals\schemas\core.schema.json" LogicalName="DbDataKit.Views.schemas.core.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\dashboard.schema.json" LogicalName="DbDataKit.Views.schemas.dashboard.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\report.schema.json" LogicalName="DbDataKit.Views.schemas.report.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\view.schema.json" LogicalName="DbDataKit.Views.schemas.view.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\vega-lite-subset.schema.json" LogicalName="DbDataKit.Views.schemas.vega-lite-subset.schema.json" />
    <!-- the locale table of the formatter (plan 32 DBR46): the TypeScript twin imports the same file -->
    <EmbeddedResource Include="..\..\web\visuals\src\views\locales.json" LogicalName="DbDataKit.Views.locales.json" />
    <ProjectReference Include="..\DbDataKit.Config.Yaml\DbDataKit.Config.Yaml.csproj" />
    <!-- the dashboards and reports an app lists under `views`, loaded and checked against its manifest (DBR13): this implements the manifest library's IViewDocumentChecker -->
    <ProjectReference Include="..\DbDataKit.Apps.Manifest\DbDataKit.Apps.Manifest.csproj" />
    <!-- the kinds dashboard and report in the registry of published definitions (DBR10), and the follower that reads a published version -->
    <ProjectReference Include="..\DbDataKit.State\DbDataKit.State.csproj" />
    <!-- the resolution of a layout (DBR04): requests run through the serving core's IServingQueries as the viewer, and a matrix or chart becomes data in the engine's ViewRenderer -->
    <ProjectReference Include="..\DbDataKit.Serving.Abstractions\DbDataKit.Serving.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataKit.Semantic\DbDataKit.Semantic.csproj" />
  </ItemGroup>
</Project>
