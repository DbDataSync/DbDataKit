<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DbDataKit.Authoring.Server</PackageId>
    <RootNamespace>DbDataKit.Authoring.Server</RootNamespace>
    <Description>The Workspace's engine, hosted by the DbDataKit console and by the standalone Workspace server (plan 33 SC05): the projects people author in git workspaces, the builds of an app from a vendored package store in a child process with no network and no environment of the host's, the read-only preview, what a build holds for the console to deploy, and the management API over them. It calls no Runner or Gateway.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="IntegrationTemplates\**\*" LogicalName="IntegrationTemplates/%(RecursiveDir)%(Filename)%(Extension)" />   <!-- the integration project templates (IX21) -->
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\DbDataKit.Authoring\DbDataKit.Authoring.csproj" />
    <ProjectReference Include="..\DbDataKit.Apps.Build\DbDataKit.Apps.Build.csproj" />
    <ProjectReference Include="..\DbDataKit.Apps.Instances\DbDataKit.Apps.Instances.csproj" />
    <ProjectReference Include="..\DbDataKit.Apps.Manifest\DbDataKit.Apps.Manifest.csproj" />
    <ProjectReference Include="..\DbDataKit.Apps.Bundling\DbDataKit.Apps.Bundling.csproj" />
    <ProjectReference Include="..\DbDataKit.Config.Git\DbDataKit.Config.Git.csproj" />
    <ProjectReference Include="..\DbDataKit.Catalog.Cache\DbDataKit.Catalog.Cache.csproj" />
    <ProjectReference Include="..\DbDataKit.Sync.Provisioning\DbDataKit.Sync.Provisioning.csproj" />   <!-- Sync's configuration model and column reader, run in process for a sync draft -->
    <ProjectReference Include="..\DbDataKit.Sync.Drivers.Descriptor\DbDataKit.Sync.Drivers.Descriptor.csproj" />   <!-- the type map and quoting of a draft's driver.yaml, for its offline checks -->
    <ProjectReference Include="..\DbDataKit.Config.Yaml\DbDataKit.Config.Yaml.csproj" />
    <ProjectReference Include="..\DbDataKit.Dialect\DbDataKit.Dialect.csproj" />   <!-- the type tables and the lexer the offline checks of a sync draft read -->
    <ProjectReference Include="..\DbDataKit.Transfer\DbDataKit.Transfer.csproj" />   <!-- FidelityRules: whether a source type fits a target type -->
    <ProjectReference Include="..\DbDataKit.DataModel\DbDataKit.DataModel.csproj" />
    <ProjectReference Include="..\DbDataKit.DataModel.Runner\DbDataKit.DataModel.Runner.csproj" />   <!-- a Store model's deploy package for a Runner (plan 33 SC24) -->
    <ProjectReference Include="..\DbDataKit.State\DbDataKit.State.csproj" />
    <ProjectReference Include="..\DbDataKit.Web\DbDataKit.Web.csproj" />
    <ProjectReference Include="..\DbDataKit.Deploy\DbDataKit.Deploy.csproj" />   <!-- BuildContents and BuildRecord: what a build holds for the control service to deploy; this server calls none of its clients -->
  </ItemGroup>
</Project>
