<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Views.Export</RootNamespace>
    <Description>The exporters of dashboards and reports (plan 32 DBR15, DBR17): the PDF and the chart SVG: one IReportExporter over PuppeteerSharp and a pinned Chromium (no Node, no download at run time, no network but the page's own files), the bundled font set, the strict views.export settings; and the CSV and xlsx of a widget's rows (no browser).</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository's browser and font pins: the versions this program release was tested with (a warning and a verification line, never a gate; ExportPins). One source: the files at the root. -->
    <EmbeddedResource Include="..\..\..\chromium.pin" LogicalName="DbDataKit.Views.Export.chromium.pin" Link="chromium.pin" />
    <EmbeddedResource Include="..\..\..\fonts.pin" LogicalName="DbDataKit.Views.Export.fonts.pin" Link="fonts.pin" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="PdfPig" />
    <!-- the xlsx of a widget or a dashboard (DBR17); the version is the root props' -->
    <PackageReference Include="ClosedXML" />
  </ItemGroup>
</Project>
