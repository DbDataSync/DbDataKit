{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbdatakit:schemas:agent:1",
  "title": "agent/1: the definition of an agent (agent.yml)",
  "description": "What an agent is (plan 27 section 3.1). The reader (AgentDefinitionLoader) is the authority; a test keeps this file's keys equal to the reader's. What the definition names (tools, skills, subagents, scopes) is checked against what exists by `agent check`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "name", "audience", "model"],
  "properties": {
    "agent": { "const": 1, "description": "The format number." },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "maxLength": 2000 },
    "description": { "type": "string", "maxLength": 2000 },
    "owner": { "type": "string", "maxLength": 2000 },
    "audience": { "enum": ["front-end", "back-end"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": { "slot": { "type": "string", "minLength": 1, "description": "A model slot, bound per channel to a provider connection and model." } }
    },
    "instructions": { "type": "array", "items": { "type": "string", "description": "A path inside the agent's project." } },
    "skills": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "prompting": { "enum": ["ask", "ask-once", "do-not-ask"] }
        },
        "oneOf": [ { "required": ["command"] }, { "required": ["action"] } ]
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic-models": { "$ref": "#/$defs/scope" },
        "store-models": { "$ref": "#/$defs/scope" },
        "build-projects": { "$ref": "#/$defs/scope" },
        "connections": { "$ref": "#/$defs/scope" },
        "apps": { "$ref": "#/$defs/scope" },
        "integrations": { "$ref": "#/$defs/scope" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "always": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "person": { "type": "boolean" }, "workspace": { "type": "boolean" } }
    },
    "subagents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": { "type": "integer", "minimum": 1 },
        "tool-calls": { "type": "integer", "minimum": 1 },
        "tokens": { "type": "integer", "minimum": 1 },
        "cost": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "output": { "type": "array", "uniqueItems": true, "items": { "enum": ["table", "matrix", "vega-lite"] } }
  },
  "$defs": {
    "scope": {
      "oneOf": [
        { "const": "all", "description": "Every object of the kind the person may use." },
        { "type": "array", "minItems": 1, "items": { "type": "string" } }
      ]
    }
  }
}
