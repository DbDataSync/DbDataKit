<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Connections.Descriptor</RootNamespace>
    <PackageId>DbDataKit.Connections.Descriptor</PackageId>
    <Description>YAML-described ADO.NET engines (engine/1) over a DbProviderFactory, using dialect.yaml for SQL facts. Fixed properties are overridable only where marked.</Description>
    <NoWarn>$(NoWarn);CS1573;CS1572</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- the registry of the engines the suite knows (engine/1 descriptors with their roles) -->
    <EmbeddedResource Include="engines\*.engine.yaml" LogicalName="DbDataKit.Connections.Descriptor.engines.%(Filename)%(Extension)" />
    <ProjectReference Include="..\DbDataKit.Connections\DbDataKit.Connections.csproj" />
  </ItemGroup>
</Project>
