<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DbDataKit.Sync.Scripting.Abstractions</PackageId>
    <Description>The slots a Sync script can be bound to (ScriptSlots), the levels it may be bound at, and the interfaces a script of each slot implements. It compiles and runs no script.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1573;CS1572;CS1587</NoWarn>   <!-- doc comments on positional record parameters, and param tags of only some parameters -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DbDataKit.Sync.Core\DbDataKit.Sync.Core.csproj" />
    <ProjectReference Include="..\DbDataKit.Sync.Drivers.Abstractions\DbDataKit.Sync.Drivers.Abstractions.csproj" />
  </ItemGroup>
</Project>
