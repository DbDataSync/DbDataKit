<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DbDataKit.Sync.Drivers.Descriptor</PackageId>
    <Description>The reader of a Sync driver.yaml (its dialect, type map, catalog queries and capabilities) and the catalog of ready-made descriptors, with no library loaded and no script compiled.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1573;CS1572;CS1587</NoWarn>   <!-- doc comments on positional record parameters, and param tags of only some parameters -->
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.yaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DbDataKit.Sync.Core\DbDataKit.Sync.Core.csproj" />
    <ProjectReference Include="..\DbDataKit.Sync.Drivers.Abstractions\DbDataKit.Sync.Drivers.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataKit.Sync.Drivers.Generic\DbDataKit.Sync.Drivers.Generic.csproj" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
</Project>
