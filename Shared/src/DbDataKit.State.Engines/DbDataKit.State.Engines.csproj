<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1573;CS1572</NoWarn>
    <Description>Opens a product's state database on the engine its operator names: SQLite (the default, a file), or SQL Server or PostgreSQL on a server the operator specifies, with the password a secret reference.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="..\DbDataKit.State\DbDataKit.State.csproj" />
    <ProjectReference Include="..\DbDataKit.Config.Yaml\DbDataKit.Config.Yaml.csproj" />
    <ProjectReference Include="..\DbDataKit.Secrets.Abstractions\DbDataKit.Secrets.Abstractions.csproj" />
  </ItemGroup>
</Project>
