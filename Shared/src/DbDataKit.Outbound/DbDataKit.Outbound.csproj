<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Outbound</RootNamespace>
    <Description>The outbound list of a service: the outbound: setting (one list of destinations, read strictly), the gate every outbound connection of the service's own code goes through, and the refusal that is logged and audited with the destination and the operation.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\DbDataKit.Config.Yaml\DbDataKit.Config.Yaml.csproj" />
  </ItemGroup>
</Project>
