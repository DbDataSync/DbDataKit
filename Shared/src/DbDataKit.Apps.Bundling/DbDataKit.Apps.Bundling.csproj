<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Turns an app's source (TypeScript, JSX, npm packages) into the static bundle the apps host serves. The bundler is a program run as a child process behind IAppBundler; Bun is the first one. No app code runs here, only the build.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
