{
  "name": "01_union_same_grain",
  "level": 2,
  "description": "Two sources at the requested grain. The engine unions them and finalizes; nothing remains.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        "budget.budget_amount"
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "orders_net_revenue": 400,
        "budget_budget_amount": 500
      },
      {
        "customers_region": "West",
        "orders_net_revenue": 500,
        "budget_budget_amount": 600
      }
    ],
    "descriptor": {
      "x_grain": [
        "customers.region"
      ],
      "x_truncated": false,
      "x_provenance": {
        "mode": "engine"
      }
    }
  }
}
