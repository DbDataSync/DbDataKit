{
  "name": "09_filtered_measure_across_sources",
  "level": 2,
  "description": "A filtered measure from SQL Server combines with budget from SSAS like any other measure.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "completed_revenue",
          "filters": [
            {
              "attribute": "orders.status",
              "operator": "equals",
              "values": [
                "Completed"
              ]
            }
          ]
        },
        "budget.budget_amount"
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "completed_revenue": 300,
        "budget_budget_amount": 500
      },
      {
        "customers_region": "West",
        "completed_revenue": 420,
        "budget_budget_amount": 600
      }
    ]
  }
}
