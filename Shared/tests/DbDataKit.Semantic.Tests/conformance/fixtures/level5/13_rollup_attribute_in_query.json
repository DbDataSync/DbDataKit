{
  "name": "13_rollup_attribute_in_query",
  "level": 5,
  "description": "There is nothing to roll up over a dimension the query already groups by.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "avg_monthly_revenue",
          "rollup": {
            "date.fiscal_month": "avg"
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "rollup_attribute_in_query"
    ]
  }
}
