{
  "name": "29_rank_keep_then_limit",
  "level": 5,
  "description": "keep 3 leaves three rows and the limit of 2 then cuts them, so the result is marked truncated.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_rank",
          "transform": "rank",
          "measure": "orders.net_revenue",
          "keep": 3
        }
      ],
      "limit": 2,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300,
        "rev_rank": 1
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "rev_rank": 1
      }
    ],
    "descriptor": {
      "x_truncated": true,
      "x_row_count": 2
    }
  }
}
