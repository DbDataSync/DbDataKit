{
  "name": "17_rollup_order_matters",
  "level": 5,
  "description": "The same two rules in the other order: months are averaged within each product, then the products added. East sold product A only in August, so its average is 100 over the months it has, and B averages 100: 200 in all, not the 133 of the other order.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "avg_monthly_revenue",
          "rollup": {
            "date.fiscal_month": "avg",
            "products.product": "sum"
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "avg_monthly_revenue": 200
      },
      {
        "customers_region": "West",
        "avg_monthly_revenue": 166.66666666666669
      }
    ]
  }
}
