{
  "name": "05_rank_is_null_on_total_rows",
  "level": 5,
  "description": "Total rows are not ranked.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_rank",
          "transform": "rank",
          "measure": "orders.net_revenue",
          "within": [
            "customers.region"
          ]
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "totals": {
        "subtotal_by": [
          "products.product"
        ]
      }
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 100,
        "rev_rank": 2
      },
      {
        "customers_region": "East",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "rev_rank": 1
      },
      {
        "customers_region": "East",
        "products_product": null,
        "_rollup_level": 1,
        "orders_net_revenue": 400,
        "rev_rank": null
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "rev_rank": 1
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 200,
        "rev_rank": 2
      },
      {
        "customers_region": "West",
        "products_product": null,
        "_rollup_level": 1,
        "orders_net_revenue": 500,
        "rev_rank": null
      }
    ]
  }
}
