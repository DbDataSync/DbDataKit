{
  "name": "31_rank_keep_of_a_share",
  "level": 5,
  "description": "Chained: rank reads the share and keeps the best share in each region.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "share",
          "transform": "pct_of_total",
          "measure": "orders.net_revenue",
          "over": [
            "products.product"
          ]
        },
        {
          "as": "share_rank",
          "transform": "rank",
          "measure": "share",
          "within": [
            "customers.region"
          ],
          "keep": 1
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300,
        "share": 0.75,
        "share_rank": 1
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "share": 0.6,
        "share_rank": 1
      }
    ]
  }
}
