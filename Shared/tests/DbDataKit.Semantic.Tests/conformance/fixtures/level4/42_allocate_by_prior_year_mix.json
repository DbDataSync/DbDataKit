{
  "name": "42_allocate_by_prior_year_mix",
  "level": 4,
  "description": "The flagship case: budget split to products by last year's sales mix. FY26-Q1 revenue is West A 240 and B 160 (60/40), East A 150 and B 150 (50/50), so West's 600 becomes 360 and 240 and East's 500 becomes 250 and 250.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "measure": "budget.budget_amount",
          "spread": {
            "allocate": {
              "by": "measure",
              "measure": "orders.net_revenue",
              "period": {
                "unit": "fiscal_year",
                "offset": -1
              }
            }
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "orders_net_revenue": 100,
        "budget_budget_amount": 250
      },
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300,
        "budget_budget_amount": 250
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "budget_budget_amount": 360
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_net_revenue": 200,
        "budget_budget_amount": 240
      }
    ]
  }
}
