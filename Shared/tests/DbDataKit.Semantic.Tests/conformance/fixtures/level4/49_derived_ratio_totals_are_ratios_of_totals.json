{
  "name": "49_derived_ratio_totals_are_ratios_of_totals",
  "level": 4,
  "description": "The grand total is the total revenue over the total distinct orders (900 over 10 = 90), never the average of the two regions' ratios (91.67).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.avg_order_value"
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "totals": {
        "subtotal_by": [
          "customers.region"
        ],
        "grand_total": true
      }
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "_rollup_level": 0,
        "orders_avg_order_value": 100
      },
      {
        "customers_region": "West",
        "_rollup_level": 0,
        "orders_avg_order_value": 83.33333333333333
      },
      {
        "customers_region": null,
        "_rollup_level": 1,
        "orders_avg_order_value": 90
      }
    ]
  }
}
