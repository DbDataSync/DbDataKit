{
  "name": "106_index_per_group_base",
  "level": 4,
  "description": "Each region is divided by its own 2026-07: West 150, 190, 160 and East 100, 200, 100, so both read 100 in the base month and West is 126.67 and 106.67 after it, East 200 and 100.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "growth",
          "transform": "index",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "base": "2026-07"
        }
      ],
      "attributes": [
        "customers.region",
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "equals",
          "values": [
            "2026-07",
            "2026-08",
            "2026-09"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 100,
        "growth": 100.0
      },
      {
        "customers_region": "East",
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 200,
        "growth": 200.0
      },
      {
        "customers_region": "East",
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 100,
        "growth": 100.0
      },
      {
        "customers_region": "West",
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 150,
        "growth": 100.0
      },
      {
        "customers_region": "West",
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 190,
        "growth": 126.66666666666666
      },
      {
        "customers_region": "West",
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 160,
        "growth": 106.66666666666667
      }
    ]
  }
}
