{
  "name": "61_prior_period_with_a_range_filter_on_the_period",
  "level": 4,
  "description": "A filter that isn't an equals on the period (fiscal months from 2026-08 on) moves back too: the engine takes the months of the date table that pass it and uses their counterparts, 2025-08 and 2025-09.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "gte",
          "values": [
            "2026-08"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "rev_prior": 160
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "rev_prior": 150
      }
    ]
  }
}