{
  "name": "46_prior_period_over_a_relative_period",
  "level": 4,
  "description": "The last 2 complete fiscal months against the same months a year earlier. A whole-period operator filters on fiscal months, which the calendar can move back.",
  "today": "2026-09-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          },
          "output": "value"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "last_complete",
          "count": 2
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "rev_prior": 390
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "rev_prior": 160
      }
    ]
  }
}
