  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "measure": "budget.budget_amount",
          "spread": {
            "allocate": {
              "by": "measure",
              "measure": "orders.net_revenue",
              "period": {
                "unit": "fiscal_year",
                "offset": -1
              }
            }
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": []
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "shift_needs_time"
    ]
  }
