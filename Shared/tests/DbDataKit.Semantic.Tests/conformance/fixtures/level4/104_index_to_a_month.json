{
  "name": "104_index_to_a_month",
  "level": 4,
  "description": "Revenue by month as an index to 2026-07 (250 = 100): 2025-07 is 390 / 250 and so on. The base month itself reads 100.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "growth",
          "transform": "index",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "base": "2026-07"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": []
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "growth": 156.0
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "growth": 64.0
      },
      {
        "date_fiscal_month": "2025-09",
        "orders_net_revenue": 150,
        "growth": 60.0
      },
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "growth": 100.0
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "growth": 156.0
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "growth": 104.0
      }
    ]
  }
}
