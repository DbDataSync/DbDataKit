{
  "name": "48_derived_ratio_by_product",
  "level": 4,
  "description": "The same ratio at a finer grain, computed from each row's own revenue and distinct orders.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.avg_order_value"
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "orders_avg_order_value": 100
      },
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_avg_order_value": 100
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_avg_order_value": 100
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_avg_order_value": 66.66666666666667
      }
    ]
  }
}
