{
  "name": "53_prior_period_a_year_later",
  "level": 4,
  "description": "A positive offset reads the calendar the other way: FY26-Q1's revenue next to the same months a year later (2025-07 is followed by 2026-07), and the filter on FY26-Q1 moves forward with it.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "later",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_year",
            "offset": 1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY26-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "later": 250
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "later": 390
      },
      {
        "date_fiscal_month": "2025-09",
        "orders_net_revenue": 150,
        "later": 260
      }
    ]
  }
}