{
  "name": "88_window_offset_on_a_datetime",
  "level": 4,
  "description": "The month before, for the months an order was placed (in Chicago) through the date table: 2026-08 is 270 against 150 in 2026-07 (+120) and 2026-09 is 180 against 270 in 2026-08 (-90).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "change",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "orders.ordered_at_fiscal_month",
          "offset": -1,
          "output": "delta"
        }
      ],
      "attributes": [
        "orders.ordered_at_fiscal_month"
      ],
      "limit": 100,
      "filters": [
        {
          "attribute": "orders.ordered_at_fiscal_month",
          "operator": "equals",
          "values": [
            "2026-08",
            "2026-09"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_fiscal_month": "2026-08",
        "orders_net_revenue": 270,
        "change": 120
      },
      {
        "orders_ordered_at_fiscal_month": "2026-09",
        "orders_net_revenue": 180,
        "change": -90
      }
    ]
  }
}
