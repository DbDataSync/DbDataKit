{
  "name": "97_chain_unknown_name",
  "level": 4,
  "description": "A name with no dot is the `as` of an earlier transform; this one isn't any.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "share",
          "transform": "pct_of_total",
          "measure": "orders.net_revenue",
          "over": [
            "date.fiscal_month"
          ]
        },
        {
          "as": "cum_share",
          "transform": "running_total",
          "measure": "shre",
          "along": "date.fiscal_month"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "transform_base_unknown"
    ]
  }
}
