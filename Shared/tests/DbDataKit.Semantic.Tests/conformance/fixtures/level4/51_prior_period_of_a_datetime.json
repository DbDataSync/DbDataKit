{
  "name": "51_prior_period_of_a_datetime",
  "level": 4,
  "description": "The same fiscal months a year earlier, for revenue by the day an order was placed (in Chicago). The calendar's fiscal-year shift applies to the datetime's fiscal month, and the filter on the fiscal quarter moves back with it.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_fiscal_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at_fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_fiscal_month": "2026-07",
        "orders_net_revenue": 150,
        "rev_prior": 150
      },
      {
        "orders_ordered_at_fiscal_month": "2026-08",
        "orders_net_revenue": 270,
        "rev_prior": 160
      },
      {
        "orders_ordered_at_fiscal_month": "2026-09",
        "orders_net_revenue": 180,
        "rev_prior": 150
      }
    ]
  }
}