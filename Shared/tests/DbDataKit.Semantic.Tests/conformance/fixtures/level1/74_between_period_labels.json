{
  "name": "74_between_period_labels",
  "level": 1,
  "description": "A period dimension sorts in time order, so between takes two of its labels: fiscal months 2026-07 to 2026-08.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "between",
          "values": [
            "2026-07",
            "2026-08"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390
      }
    ]
  }
}