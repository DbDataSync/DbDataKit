{
  "name": "37_by_day",
  "level": 1,
  "description": "Day is a level too: the date attribute itself, here with a between filter on it. Only the days with sales appear.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.calendar_date"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-09-30"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_calendar_date": "2026-07-01",
        "orders_net_revenue": 250
      },
      {
        "date_calendar_date": "2026-08-01",
        "orders_net_revenue": 390
      },
      {
        "date_calendar_date": "2026-09-01",
        "orders_net_revenue": 260
      }
    ]
  }
}
