{
  "name": "68_relative_fiscal_range_on_a_datetime",
  "level": 1,
  "description": "The last 2 complete fiscal months of a datetime that is tied to the date dimension: the date table decides what a fiscal month is, and today (2026-09-15) is in 2026-09.",
  "today": "2026-09-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_fiscal_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at_fiscal_month",
          "operator": "last_complete",
          "count": 2
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_fiscal_month": "2026-07",
        "orders_net_revenue": 150
      },
      {
        "orders_ordered_at_fiscal_month": "2026-08",
        "orders_net_revenue": 270
      }
    ]
  }
}