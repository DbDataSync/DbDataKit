{
  "name": "41_equals_a_period_with_no_data",
  "level": 1,
  "description": "equals on a period that isn't in the data (no fiscal year is called FY99) is an ordinary filter that matches nothing.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_year",
          "operator": "equals",
          "values": [
            "FY99"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "rows": []
  }
}
