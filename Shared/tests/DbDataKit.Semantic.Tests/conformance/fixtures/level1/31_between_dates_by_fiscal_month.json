{
  "name": "31_between_dates_by_fiscal_month",
  "level": 1,
  "description": "Dates written out as a between filter on the date attribute, broken down by fiscal month (listed in attributes like any other attribute).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-08-31"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "result_sets": [
      {
        "id": "d1",
        "grain": [
          "date.fiscal_month"
        ],
        "covers": {
          "measures": [
            "orders.net_revenue"
          ],
          "filters_applied": [
            "date.calendar_date between 2026-07-01, 2026-08-31"
          ],
          "filters_not_applied": []
        }
      }
    ],
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390
      }
    ]
  }
}
