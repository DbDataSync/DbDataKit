{
  "name": "@dbdatakit/view-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The runtime of an app of views only (plan 26, AP25) and the library an app's code builds on (plan 22a GP32, GP34): the host connection, the app's data clients, and the components that draw view-spec/1 files with the shared controls and renderers.",
  "exports": {
    ".": "./src/lib.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p . && vite build",
    "lint": "oxlint --ignore-pattern dist",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dbdatakit/semantic-client": "*",
    "@dbdatakit/store-ui": "*",
    "@dbdatakit/visuals": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
