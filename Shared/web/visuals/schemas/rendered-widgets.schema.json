{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbdatakit.invalid/visuals/rendered-widgets.schema.json",
  "title": "Rendered widgets",
  "description": "What resolving a layout gives (plan 32 DBR04; DbDataKit.Views WidgetResolver) and the widget renderers draw (src/views/rendered.ts): for each widget the layout placed, by id, a metric, a table, a matrix, a chart, text, an image, the values a control lists, or an error entry. It is an output schema, not a stored definition: nothing here is written by a person. A number reads as the server formatted it (`text`); a matrix and a chart are the shapes of rendered-view.schema.json with the widget's id.",
  "type": "object",
  "required": ["kind", "layout", "as_of", "widgets"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "rendered_widgets" },
    "layout": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$", "description": "When the rows were read (ISO 8601, UTC)." },
    "widgets": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/widget" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "number": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": { "v": { "type": ["number", "null"] }, "text": { "type": "string" } }
    },
    "widget": {
      "oneOf": [
        { "$ref": "#/$defs/metric" }, { "$ref": "#/$defs/table" }, { "$ref": "#/$defs/matrix" }, { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/image" }, { "$ref": "#/$defs/control" }, { "$ref": "#/$defs/embed" }, { "$ref": "#/$defs/error" }
      ]
    },
    "metric": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "value": { "oneOf": [{ "$ref": "#/$defs/number" }, { "type": "null" }] },
        "compare": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "v": { "type": ["number", "null"] },
                "text": { "type": "string" },
                "change": {
                  "type": "object",
                  "required": ["text", "direction"],
                  "additionalProperties": false,
                  "properties": { "text": { "type": "string" }, "direction": { "enum": ["up", "down", "flat"] } }
                }
              }
            }
          ]
        }
      }
    },
    "table": {
      "type": "object",
      "required": ["type", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "label"],
            "additionalProperties": false,
            "properties": { "field": { "type": "string" }, "label": { "type": "string" }, "align": { "enum": ["left", "right", "center"] } }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cells"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": "boolean", "description": "A total row is a row of the result and says so." },
              "cells": {
                "type": "array",
                "items": { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "v": { "$ref": "#/$defs/value" }, "text": { "type": "string" } } }
              }
            }
          }
        },
        "total_rows": { "type": "integer", "minimum": 0, "description": "The rows the query had, when the server cut them at its limit." }
      }
    },
    "matrix": {
      "type": "object",
      "required": ["id", "type", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "matrix" },
        "notice": { "type": ["string", "null"] },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labels"],
            "additionalProperties": false,
            "properties": { "labels": { "type": "array", "items": { "type": "string" } }, "total": { "type": "boolean" }, "other": { "type": "boolean" } }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labels", "cells"],
            "additionalProperties": false,
            "properties": {
              "labels": { "type": "array", "items": { "type": "string" } },
              "total": { "type": "boolean" },
              "cells": { "type": "array", "items": { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "v": { "type": ["number", "null"] }, "text": { "type": "string" } } } }
            }
          }
        }
      }
    },
    "d3_format": { "type": "string", "pattern": "^\\$?,?\\.[0-9]{1,2}~?[fs%]$" },
    "chart": {
      "type": "object",
      "required": ["id", "type", "vega_lite"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "chart" },
        "nested_axis": { "description": "The renderer drew a multi-level `x` as an inner `x` and the outer level as the `column` channel (plan 32 DBR42): the client draws the column as group headers below the inner labels, with no space between groups.", "type": "boolean" },
        "formats": {
          "description": "d3-format strings the renderer's own format mapping made for the quantitative channels (plan 32 DBR41), by channel; a tooltip's is a list in the order of its entries (null where an entry has none). The client checks each against a fixed pattern before it gives it to Vega-Lite.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/d3_format" },
            "y": { "$ref": "#/$defs/d3_format" },
            "color": { "$ref": "#/$defs/d3_format" },
            "column": { "$ref": "#/$defs/d3_format" },
            "row": { "$ref": "#/$defs/d3_format" },
            "tooltip": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/d3_format" }, { "type": "null" }] } }
          }
        },
        "vega_lite": {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": {
              "type": "object",
              "required": ["values"],
              "additionalProperties": false,
              "properties": { "values": { "type": "array", "items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } } } }
            }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "description": "The widget's markdown with {{params.x}} substituted as text, from the server. Optional: a renderer that has the document draws from it and substitutes itself; markup is never made from a value." }
      }
    },
    "image": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": { "type": { "const": "image" }, "src": { "type": "string", "pattern": "^data:image/(png|jpeg|webp);base64,", "description": "The bytes of a raster as a data: URI. Never an address, never an SVG." } }
    },
    "embed": {
      "type": "object",
      "required": ["type", "url", "framed"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "embed" },
        "url": { "type": "string", "pattern": "^https://", "description": "The report server's address with the widget's pairs filled in." },
        "origin": { "type": ["string", "null"], "description": "Scheme, host and port of the address." },
        "framed": { "type": "boolean", "description": "True when the host approves the origin to be framed; otherwise the widget is a link." },
        "link_text": { "type": "string" }
      }
    },
    "control": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "control" },
        "values": {
          "type": "array",
          "items": { "type": "object", "required": ["value"], "additionalProperties": false, "properties": { "value": { "type": ["string", "number", "boolean"] }, "label": { "type": "string" } } }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "suggestions": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    }
  }
}
