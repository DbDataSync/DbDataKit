{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbdatakit.invalid/visuals/core.schema.json",
  "title": "Dashboard and report core",
  "description": "The one core of the dashboard/1 and report/1 documents (plan 32 sections 2 and 3): the widget vocabulary, parameters, layouts of the three types (reflow, canvas, flow), selectors and per-layout options. Only $defs; dashboard.schema.json and report.schema.json reference it and add their own keys. Closed: a key not listed is refused. A widget carries encodings and a declarative query, never a computation in the chart spec; a layout places widgets and never changes one. The matrix and chart encodings are the view schema's own definitions (view.schema.json, vega-lite-subset.schema.json), referenced and not copied.",
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "field": { "description": "A field by logical name (orders.net_revenue) or by the alias of a query output.", "type": "string", "minLength": 1 },
    "format": {
      "description": "How a metric or a table column shows its values (plan 32 section 9g): a named number preset (catalog takes the catalog's own format of the field), a number mapping {style: number | currency | percent | compact, decimals 0 to 10, currency (an ISO 4217 code, with style currency), grouping}, or a date mapping {date: year | quarter | month | month-year | date | datetime, or a pattern of the tokens yyyy yy Q MMMM MMM MM dd HH mm ss and literal text in single quotes}. The keys inside a mapping are checked by the loaders (DbDataKit.Views ViewFormat, src/views/format.ts), each with its own words, so the schema says only the two shapes.",
      "type": ["string", "object"],
      "examples": ["catalog", "full", "compact", "percent", { "style": "currency", "currency": "EUR", "decimals": 0 }, { "date": "month-year" }]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },

    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["string", "integer", "number", "boolean"] },
        "for": { "description": "The attribute the parameter is a value of (J25).", "$ref": "#/$defs/field" },
        "many": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": {},
        "label": { "$ref": "#/$defs/title" }
      }
    },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "locale": { "description": "The language numbers and dates are written in: the separators of a number and the names of the months (plan 32 DBR46). A request may ask for another; the default is the server's, else en.", "enum": ["en", "de", "fr", "es", "it", "pt", "nl"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "font": { "description": "sans, serif or mono: the bundled families (plan 32 section 4.6). A host font by name is added with the export settings (DBR15b).", "enum": ["sans", "serif", "mono"] } }
    },

    "param_map": {
      "description": "A request's parameter name and the document parameter that supplies it; a name not listed is supplied by the parameter of the same name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/name" }
    },
    "query_derived": {
      "description": "The request is derived from the encodings (DeriveRequest, DBR03); the document holds the parts a person chooses beside them.",
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "derived" },
        "model": { "$ref": "#/$defs/name" },
        "filters": { "type": "array" },
        "segments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "order": { "type": "array" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "totals": { "type": "object" },
        "timezone": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/param_map" }
      }
    },
    "query_explicit_semantic": {
      "type": "object",
      "required": ["mode", "semantic"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "explicit" },
        "semantic": {
          "type": "object",
          "required": ["model"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/name" },
            "request": { "description": "A semantic request as docs/semantic/query.md defines it; the engine validates it (the catalog check).", "type": "object" },
            "sql": { "type": "string", "minLength": 1 }
          }
        },
        "params": { "$ref": "#/$defs/param_map" }
      }
    },
    "query_explicit_saved": {
      "type": "object",
      "required": ["mode", "saved"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "explicit" },
        "saved": { "$ref": "#/$defs/name" },
        "outputs": { "description": "The saved query's declared outputs, when the file cannot see the saved query (the shape check of the binding).", "type": "array", "items": { "$ref": "#/$defs/field" } },
        "params": { "$ref": "#/$defs/param_map" }
      }
    },
    "query_explicit_store": {
      "type": "object",
      "required": ["mode", "store"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "explicit" },
        "store": {
          "type": "object",
          "required": ["model", "entity"],
          "additionalProperties": false,
          "properties": {
            "model": { "$ref": "#/$defs/name" },
            "entity": { "$ref": "#/$defs/name" },
            "columns": { "description": "The columns the read returns, when the file lists them (the shape check of the binding).", "type": "array", "items": { "$ref": "#/$defs/field" } },
            "filter": { "type": "object" },
            "sort": { "type": "array" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        "params": { "$ref": "#/$defs/param_map" }
      }
    },
    "query_explicit_ref": {
      "description": "An already run result (an assistant's answer): no query.",
      "type": "object",
      "required": ["mode", "ref"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "explicit" },
        "ref": { "type": "string", "minLength": 1 },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "query": {
      "oneOf": [
        { "$ref": "#/$defs/query_derived" },
        { "$ref": "#/$defs/query_explicit_semantic" },
        { "$ref": "#/$defs/query_explicit_saved" },
        { "$ref": "#/$defs/query_explicit_store" },
        { "$ref": "#/$defs/query_explicit_ref" }
      ]
    },

    "on_select": {
      "type": "object",
      "required": ["set", "from"],
      "additionalProperties": false,
      "properties": { "set": { "$ref": "#/$defs/name" }, "from": { "$ref": "#/$defs/field" } }
    },
    "drill": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "dashboard": { "$ref": "#/$defs/name" },
            "report": { "$ref": "#/$defs/name" },
            "view": { "$ref": "#/$defs/name" }
          }
        },
        "with": { "description": "Parameter name to a value: $field of the clicked row, $params.name, or a literal.", "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "string" } }
      }
    },

    "link_value": { "description": "A value passed to the target: $field of the clicked row ($orders.id), $params.name of the document, or a literal.", "type": ["string", "number", "boolean"] },
    "link_values": { "type": "object", "propertyNames": { "$ref": "#/$defs/link_value_name" }, "additionalProperties": { "$ref": "#/$defs/link_value" } },
    "link_value_name": { "description": "A parameter or field of the target (the target's own rule, so letters of either case).", "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "link": {
      "description": "One link of the shared vocabulary (plan 32 section 9f, DBR35): exactly one target (a dashboard, report, view, page or form of the same app instance), the values it is given (`with` for the first four; `new` prefilled defaults or `edit` the key of an existing row for a form), how the shell presents it (`as`), what re-runs when it closes or saves (`then`), the prefilled fields a form shows read-only (`lock`: a convenience of the screen, never a rule) and what an export draws (`print`, `image`). A prefilled value is a default and never authority: the target validates and the server enforces.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["dashboard"] }, { "required": ["report"] }, { "required": ["view"] }, { "required": ["page"] }, { "required": ["form"] }
      ],
      "properties": {
        "dashboard": { "$ref": "#/$defs/name" },
        "report": { "$ref": "#/$defs/name" },
        "view": { "$ref": "#/$defs/name" },
        "page": { "$ref": "#/$defs/name" },
        "form": { "$ref": "#/$defs/name" },
        "with": { "description": "Parameters of a dashboard, report, view or page.", "$ref": "#/$defs/link_values" },
        "new": { "description": "A form that creates a row: the fields it starts with.", "$ref": "#/$defs/link_values" },
        "edit": { "description": "A form that changes an existing row: the key's values.", "$ref": "#/$defs/link_values" },
        "as": { "enum": ["navigate", "dialog", "panel"], "default": "navigate" },
        "then": { "description": "What re-runs when the target closes or saves: refresh (the source widget's queries, the default after a form), none, or a list of widgets.", "oneOf": [{ "enum": ["refresh", "none"] }, { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/name" } }] },
        "lock": { "description": "Fields of the form that were given in `new` or `edit` and show read-only.", "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/link_value_name" } },
        "print": { "description": "What a PDF or print draws: hidden, normal (as on screen, no link behaviour) or link (a PDF hyperlink; the address is never printed as text). Not link where the target has no address of its own (dialog, panel).", "enum": ["hidden", "normal", "link"] },
        "image": { "description": "The same for a PNG snapshot; link is drawn as normal there. Defaults to print.", "enum": ["hidden", "normal", "link"] },
        "label": { "$ref": "#/$defs/title" }
      }
    },
    "links": { "type": "object", "maxProperties": 100, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/link" } },

    "alias": { "description": "A new snake_case name for a measure's output (the engine's `as`): the same measure put in a visual twice, or a filtered one, is told apart by it (plan 32 DBR50).", "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "measure_filters": { "description": "A filtered measure's own filters (the semantic request's filter grammar, `docs/semantic/query.md`, checked by the engine at publish): they intersect with the query's and never replace them. A filter value may be {param: name}. Needs an `alias` (the engine's `alias_required`, said by the derivation).", "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } },
    "measure_field": {
      "description": "A measure's entry in a measure well (a metric's `value` and `compare`): a field name, or the object form (plan 32 section 9h, DBR50) `{field, alias, label, filters, format}`.",
      "type": ["string", "object"],
      "minLength": 1,
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/field" },
        "alias": { "$ref": "#/$defs/alias" },
        "label": { "type": "string" },
        "filters": { "$ref": "#/$defs/measure_filters" },
        "format": { "$ref": "#/$defs/format" }
      }
    },
    "icon": { "description": "An icon of the closed vocabulary an attribute's value may show as (plan 32 DBR51): drawn from the bundled icon set, never by name from the page.", "enum": ["circle", "dot", "check", "cross", "warning", "info", "clock", "flag", "star", "pause", "play", "stop", "lock", "unlock", "arrow-up", "arrow-down", "arrow-right", "plus", "minus", "pin", "bell", "eye", "user", "tag"] },
    "attribute_display": { "description": "How an attribute reads in a cell: text, an icon chosen by the value, or a badge.", "enum": ["text", "icon", "badge"] },
    "attribute_icons": { "description": "The icon each value of the attribute shows as (display: icon); a value the map does not list shows as text.", "type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": { "$ref": "#/$defs/icon" } },
    "attribute_many": { "description": "What a matrix cell with several rows shows: mixed (a marker, the values in a tooltip; the default), first, last, count (the number of distinct values) or list (comma-joined, capped).", "enum": ["mixed", "first", "last", "count", "list"] },
    "chart_channel": {
      "description": "The Vega-Lite subset's channel object (its own definitions of field, type, sort, stack and title, referenced and not copied), `format` (plan 32 DBR41: how the channel's values read on an axis, in a legend and in a tooltip) and, on a measure, `alias` and `filters` (DBR50). The subset and the QIS view (0.3) are unchanged: the format belongs to the widget vocabulary and the renderer maps it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/channel/properties/field" },
        "type": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/channel/properties/type" },
        "sort": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/channel/properties/sort" },
        "stack": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/channel/properties/stack" },
        "title": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/channel/properties/title" },
        "format": { "$ref": "#/$defs/format" },
        "alias": { "$ref": "#/$defs/alias" },
        "filters": { "$ref": "#/$defs/measure_filters" }
      }
    },
    "encoding_channel": {
      "description": "A chart channel: a field name, or the channel object (the subset's and `format`).",
      "oneOf": [{ "$ref": "#/$defs/field" }, { "$ref": "#/$defs/chart_channel" }]
    },
    "x_levels": {
      "description": "A nested axis (plan 32 DBR42): the levels of a bar or point chart's `x`, outermost first, at most three; each a field name or `{field, format, sort, title}`, `sort` being the QIS view's `{by, dir}` (sort_key, label, or a measure on the innermost level). A line or an area mark and a `column` channel are refused by the loaders (they need the mark and the other channels).",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/field" },
          {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/field" },
              "format": { "$ref": "#/$defs/format" },
              "sort": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/sort" },
              "title": { "type": "string" }
            }
          }
        ]
      }
    },
    "chart_encodings": {
      "description": "The channels of the Vega-Lite subset's encoding (the test compares the names).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "oneOf": [{ "$ref": "#/$defs/encoding_channel" }, { "$ref": "#/$defs/x_levels" }] },
        "y": { "description": "One measure, or a list of them (plan 32 DBR50): each is one series, told apart by its `alias` when one measure is there twice.", "oneOf": [{ "$ref": "#/$defs/encoding_channel" }, { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/encoding_channel" } }] },
        "color": { "$ref": "#/$defs/encoding_channel" },
        "column": { "$ref": "#/$defs/encoding_channel" },
        "row": { "$ref": "#/$defs/encoding_channel" },
        "tooltip": { "oneOf": [{ "$ref": "#/$defs/encoding_channel" }, { "type": "array", "items": { "$ref": "#/$defs/encoding_channel" } }] }
      }
    },
    "matrix_axis": {
      "description": "The attributes of a matrix axis, outermost first (plan 32 DBR41): each a field name, or `{field, format, sort}`: the format of the member labels at that level and the sort of the axis (the QIS view's own sort object, by sort_key, label or a measure). Only one level of an axis may carry a sort, which is the axis's sort.",
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/field" },
          {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/field" },
              "format": { "$ref": "#/$defs/format" },
              "sort": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/sort" }
            }
          }
        ]
      }
    },
    "matrix_values": {
      "description": "The values of a matrix: a measure (the QIS view's own `field`, `empty` and `label`, a `format` that is a preset or a mapping, and `alias` and `filters`, DBR50) or an attribute in the cell area (`attribute` with `display`, `icons`, `many`, `link`; plan 32 DBR51). An entry is one or the other.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "anyOf": [{ "required": ["field"] }, { "required": ["attribute"] }],
        "additionalProperties": false,
        "properties": {
          "field": { "$ref": "#/$defs/field" },
          "attribute": { "$ref": "#/$defs/field" },
          "empty": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/values/items/properties/empty" },
          "format": { "$ref": "#/$defs/format" },
          "label": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/values/items/properties/label" },
          "alias": { "$ref": "#/$defs/alias" },
          "filters": { "$ref": "#/$defs/measure_filters" },
          "display": { "$ref": "#/$defs/attribute_display" },
          "icons": { "$ref": "#/$defs/attribute_icons" },
          "many": { "$ref": "#/$defs/attribute_many" },
          "link": { "$ref": "#/$defs/name" }
        }
      }
    },
    "matrix_encodings": {
      "description": "A QIS matrix view's own properties (everything but type and id), referenced from view.schema.json, except the axes and the values, which also take a format (matrix_axis, matrix_values; plan 32 DBR41).",
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "rows": { "$ref": "#/$defs/matrix_axis" },
        "columns": { "$ref": "#/$defs/matrix_axis" },
        "values": { "$ref": "#/$defs/matrix_values" },
        "values_on": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/values_on" },
        "totals": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/totals" },
        "sort": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/sort" },
        "column_limit": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/matrix/properties/column_limit" }
      }
    },
    "table_column": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/field" },
        "label": { "type": "string" },
        "format": { "$ref": "#/$defs/format" },
        "align": { "enum": ["left", "right", "center"] },
        "width": { "description": "A width hint in CSS pixels.", "type": "integer", "minimum": 20, "maximum": 2000 },
        "alias": { "$ref": "#/$defs/alias" },
        "filters": { "$ref": "#/$defs/measure_filters" },
        "display": { "$ref": "#/$defs/attribute_display" },
        "icons": { "$ref": "#/$defs/attribute_icons" },
        "link": { "description": "The name of a link of the document that a click on the cell follows (plan 32 DBR51).", "$ref": "#/$defs/name" }
      }
    },

    "widget_metric": {
      "type": "object",
      "required": ["type", "encodings", "query"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "title": { "$ref": "#/$defs/title" },
        "label": { "type": "string", "maxLength": 200 },
        "format": { "$ref": "#/$defs/format" },
        "encodings": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/measure_field" }, "compare": { "$ref": "#/$defs/measure_field" } }
        },
        "query": { "$ref": "#/$defs/query" }
      }
    },
    "widget_chart": {
      "type": "object",
      "required": ["type", "mark", "encodings", "query"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chart" },
        "title": { "$ref": "#/$defs/title" },
        "mark": { "$ref": "https://dbdatakit.invalid/visuals/vega-lite-subset.schema.json#/$defs/spec/properties/mark" },
        "encodings": { "$ref": "#/$defs/chart_encodings" },
        "query": { "$ref": "#/$defs/query" },
        "on_select": { "$ref": "#/$defs/on_select" },
        "drill": { "$ref": "#/$defs/drill" },
        "on_click": { "description": "The name of a link of the document that a click on a mark or cell follows (instead of `drill`, which is the same thing written in place).", "$ref": "#/$defs/name" }
      }
    },
    "widget_matrix": {
      "type": "object",
      "required": ["type", "encodings", "query"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "matrix" },
        "title": { "$ref": "#/$defs/title" },
        "encodings": { "$ref": "#/$defs/matrix_encodings" },
        "query": { "$ref": "#/$defs/query" },
        "on_select": { "$ref": "#/$defs/on_select" },
        "drill": { "$ref": "#/$defs/drill" },
        "on_click": { "description": "The name of a link of the document that a click on a mark or cell follows (instead of `drill`, which is the same thing written in place).", "$ref": "#/$defs/name" }
      }
    },
    "widget_table": {
      "type": "object",
      "required": ["type", "encodings", "query"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "title": { "$ref": "#/$defs/title" },
        "encodings": {
          "type": "object",
          "required": ["columns"],
          "additionalProperties": false,
          "properties": {
            "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/table_column" } },
            "sort": { "$ref": "https://example.internal/qis/view.schema.json#/$defs/sort" }
          }
        },
        "query": { "$ref": "#/$defs/query" },
        "drill": { "$ref": "#/$defs/drill" },
        "on_click": { "description": "The name of a link of the document that a click on a row follows.", "$ref": "#/$defs/name" }
      }
    },
    "widget_text": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "title": { "$ref": "#/$defs/title" },
        "text": { "description": "Markdown, the safe subset of the portal home: no raw HTML, no image, links only to a path on the host; {{params.name}} is substituted as text.", "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "widget_image": {
      "type": "object",
      "required": ["type", "hash", "media_type", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" },
        "title": { "$ref": "#/$defs/title" },
        "hash": { "description": "The image's bytes in the definition's artifacts, by SHA-256 (plan 30 payloads). Never a URL.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "media_type": { "description": "A raster only: SVG can script and is refused.", "enum": ["image/png", "image/jpeg", "image/webp"] },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "fit": { "enum": ["contain", "cover"] }
      }
    },
    "widget_control": {
      "type": "object",
      "required": ["type", "parameter"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "control" },
        "title": { "$ref": "#/$defs/title" },
        "parameter": { "$ref": "#/$defs/name" },
        "control": { "enum": ["select", "multiselect", "date", "daterange", "number", "toggle", "text"] },
        "label": { "type": "string", "maxLength": 200 },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "attribute": { "$ref": "#/$defs/field" }, "limit": { "type": "integer", "minimum": 1, "maximum": 10000 } }
        }
      }
    },
    "widget_embed": {
      "description": "An external report server's report (plan 32 DBR19, dashboards only: a report is paged and exported and refuses it, which the loaders say). Framed when the host approves the address's origin (an app instance's `frame` exception, plan 26 AP17), a link when it does not.",
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "embed" },
        "title": { "$ref": "#/$defs/title" },
        "url": { "description": "An absolute https address, no credentials, no spaces, at most 2000 characters.", "type": "string", "pattern": "^https://[^\\s@/]+([/?#]\\S*)?$", "maxLength": 2000 },
        "with": {
          "description": "Query-string pairs added to the address: a name to `$params.name` (a declared parameter, left out when it has no value) or a literal.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$" },
          "additionalProperties": { "type": "string" }
        },
        "link_text": { "description": "The words of the link shown when the address is not framed.", "type": "string", "maxLength": 200 }
      }
    },
    "widget_custom": {
      "description": "Code of an app (plan 32 section 9f, DBR30): a component the app's code registers with `defineWidget` of `@dbdatakit/views-sdk`, drawn in the app's sandboxed frame. The app's manifest declares what it needs (its queries and parameters); the document names the component, gives it the values of its parameters and lists the links it may open (a custom widget fires only a named link). Only an app's own host draws it.",
      "type": "object",
      "required": ["type", "component"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "custom" },
        "title": { "$ref": "#/$defs/title" },
        "component": { "description": "`<app>/<Export>`: the app's name, then the name its code registers.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}/[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "params": { "description": "The component's parameters by name: `$params.name` of the document or a literal (there is no clicked row).", "$ref": "#/$defs/link_values" },
        "links": { "description": "The links of the document the component may open with `open(name, row)`.", "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
      }
    },
    "widget": {
      "description": "A widget by its type.",
      "oneOf": [
        { "$ref": "#/$defs/widget_metric" },
        { "$ref": "#/$defs/widget_chart" },
        { "$ref": "#/$defs/widget_matrix" },
        { "$ref": "#/$defs/widget_table" },
        { "$ref": "#/$defs/widget_text" },
        { "$ref": "#/$defs/widget_image" },
        { "$ref": "#/$defs/widget_control" },
        { "$ref": "#/$defs/widget_embed" },
        { "$ref": "#/$defs/widget_custom" }
      ]
    },
    "widgets": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/widget" } },

    "range": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }
    },
    "medium": { "enum": ["screen", "print", "export"] },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/range" },
        "height": { "$ref": "#/$defs/range" },
        "orientation": { "enum": ["portrait", "landscape"] },
        "aspect": { "$ref": "#/$defs/range" },
        "medium": { "oneOf": [{ "$ref": "#/$defs/medium" }, { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/medium" } }] }
      }
    },
    "widget_options": {
      "description": "A layout restyles a widget only through these; it never changes a widget's type, encodings, query, formats or parameters.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "density": { "enum": ["compact", "comfortable"] },
          "show_title": { "type": "boolean" },
          "legend": { "enum": ["show", "hide"] }
        }
      }
    },
    "min_size": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "tile_reflow": {
      "type": "object",
      "required": ["widget", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "widget": { "$ref": "#/$defs/name" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 },
        "min": { "$ref": "#/$defs/min_size" }
      }
    },
    "tile_canvas": {
      "type": "object",
      "required": ["widget", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "widget": { "$ref": "#/$defs/name" },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "layer": { "type": "integer", "minimum": 0, "maximum": 20 },
        "min": { "$ref": "#/$defs/min_size" }
      }
    },
    "margin": { "type": "number", "minimum": 0, "maximum": 100 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "oneOf": [
            { "enum": ["A3", "A4", "A5", "Letter", "Legal"] },
            { "type": "object", "required": ["w", "h"], "additionalProperties": false, "properties": { "w": { "type": "number", "minimum": 50, "maximum": 2000 }, "h": { "type": "number", "minimum": 50, "maximum": 2000 } } }
          ]
        },
        "orientation": { "enum": ["portrait", "landscape"] },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "top": { "$ref": "#/$defs/margin" }, "right": { "$ref": "#/$defs/margin" }, "bottom": { "$ref": "#/$defs/margin" }, "left": { "$ref": "#/$defs/margin" } }
        }
      }
    },
    "running_text": {
      "description": "Text with {title} {page} {pages} {asof} {viewer} {params.name}.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "left": { "type": "string", "maxLength": 200 }, "center": { "type": "string", "maxLength": 200 }, "right": { "type": "string", "maxLength": 200 } }
    },
    "flow_widget_block": {
      "type": "object",
      "required": ["widget"],
      "additionalProperties": false,
      "properties": {
        "widget": { "$ref": "#/$defs/name" },
        "height": { "description": "Millimetres.", "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "keep": { "type": "boolean" },
        "repeat_header": { "type": "boolean" }
      }
    },
    "flow_row_block": {
      "type": "object",
      "required": ["row"],
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["widget", "span"],
            "additionalProperties": false,
            "properties": { "widget": { "$ref": "#/$defs/name" }, "span": { "type": "integer", "minimum": 1, "maximum": 12 } }
          }
        },
        "keep": { "type": "boolean" }
      }
    },
    "flow_break_block": {
      "type": "object",
      "required": ["pagebreak"],
      "additionalProperties": false,
      "properties": { "pagebreak": { "const": true } }
    },
    "flow_section": {
      "type": "object",
      "required": ["blocks"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "break": { "enum": ["before", "after"] },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "$ref": "#/$defs/flow_widget_block" }, { "$ref": "#/$defs/flow_row_block" }, { "$ref": "#/$defs/flow_break_block" }] }
        }
      }
    },
    "layout_reflow": {
      "type": "object",
      "required": ["name", "type", "grid", "tiles"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "const": "reflow" },
        "default": { "type": "boolean" },
        "when": { "$ref": "#/$defs/selector" },
        "widget_options": { "$ref": "#/$defs/widget_options" },
        "grid": {
          "type": "object",
          "required": ["columns"],
          "additionalProperties": false,
          "properties": { "columns": { "type": "integer", "minimum": 1, "maximum": 48 }, "rows": { "type": "integer", "minimum": 1, "maximum": 100 } }
        },
        "tiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tile_reflow" } }
      }
    },
    "layout_canvas": {
      "type": "object",
      "required": ["name", "type", "canvas", "tiles"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "const": "canvas" },
        "default": { "type": "boolean" },
        "when": { "$ref": "#/$defs/selector" },
        "widget_options": { "$ref": "#/$defs/widget_options" },
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["px", "mm", "in"] }
          }
        },
        "overflow": { "enum": ["scale", "scroll"] },
        "min_scale": { "type": "number", "exclusiveMinimum": 0 },
        "max_scale": { "type": "number", "exclusiveMinimum": 0 },
        "tiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tile_canvas" } }
      }
    },
    "layout_flow": {
      "type": "object",
      "required": ["name", "type", "sections"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "const": "flow" },
        "default": { "type": "boolean" },
        "when": { "$ref": "#/$defs/selector" },
        "widget_options": { "$ref": "#/$defs/widget_options" },
        "page": { "$ref": "#/$defs/page" },
        "header": { "$ref": "#/$defs/running_text" },
        "footer": { "$ref": "#/$defs/running_text" },
        "cover": { "type": "object", "additionalProperties": false, "properties": { "parameters": { "type": "boolean" } } },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/flow_section" } }
      }
    },
    "layout": {
      "oneOf": [{ "$ref": "#/$defs/layout_reflow" }, { "$ref": "#/$defs/layout_canvas" }, { "$ref": "#/$defs/layout_flow" }]
    },
    "layouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layout" } }
  }
}
