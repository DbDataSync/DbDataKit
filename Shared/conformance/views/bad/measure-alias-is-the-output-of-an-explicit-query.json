{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Filtered measures",
  "widgets": {
    "w": {
      "type": "metric",
      "encodings": {
        "value": {
          "field": "revenue",
          "alias": "open_revenue"
        }
      },
      "query": {
        "mode": "explicit",
        "saved": "total_revenue",
        "outputs": [
          "revenue"
        ]
      }
    }
  },
  "layouts": [
    {
      "name": "desk",
      "type": "reflow",
      "default": true,
      "grid": {
        "columns": 12
      },
      "tiles": [
        {
          "widget": "w",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      ]
    }
  ]
}
