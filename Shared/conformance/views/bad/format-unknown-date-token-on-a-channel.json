{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Formats",
  "widgets": {
    "by_month": {
      "type": "chart",
      "title": "Revenue by month",
      "mark": "bar",
      "encodings": {
        "x": {
          "field": "date.month",
          "format": {
            "date": "yyy"
          }
        },
        "y": "orders.net_revenue"
      },
      "query": {
        "model": "sales"
      }
    }
  },
  "layouts": [
    {
      "name": "desk",
      "type": "reflow",
      "default": true,
      "grid": {
        "columns": 12
      },
      "tiles": [
        {
          "widget": "by_month",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      ]
    }
  ]
}
