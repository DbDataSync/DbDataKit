{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Groups",
  "groups": {
    "period": {
      "fields": [
        "orders.ordered_at_year",
        "orders.ordered_at_month"
      ],
      "colour": "red"
    }
  },
  "widgets": {
    "w": {
      "type": "chart",
      "mark": "line",
      "encodings": {
        "x": {
          "group": "period"
        },
        "y": "orders.net_revenue"
      },
      "query": {
        "model": "sales_catalog"
      }
    }
  },
  "layouts": [
    {
      "name": "desk",
      "type": "reflow",
      "default": true,
      "grid": {
        "columns": 12
      },
      "tiles": [
        {
          "widget": "w",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      ]
    }
  ]
}
