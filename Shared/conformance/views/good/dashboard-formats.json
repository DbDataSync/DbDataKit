{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Formats",
  "widgets": {
    "revenue": {
      "type": "metric",
      "label": "Revenue",
      "format": {
        "style": "currency",
        "currency": "EUR",
        "decimals": 0
      },
      "encodings": {
        "value": "orders.net_revenue"
      },
      "query": {
        "model": "sales"
      }
    },
    "by_month": {
      "type": "table",
      "encodings": {
        "columns": [
          {
            "field": "date.month",
            "label": "Month",
            "format": {
              "date": "month-year"
            }
          },
          {
            "field": "orders.net_revenue",
            "label": "Net revenue",
            "format": {
              "style": "compact",
              "decimals": 1
            },
            "align": "right"
          }
        ]
      },
      "query": {
        "model": "sales",
        "limit": 100
      }
    },
    "share": {
      "type": "metric",
      "label": "Revenue",
      "format": {
        "style": "percent",
        "decimals": 1
      },
      "encodings": {
        "value": "orders.net_revenue"
      },
      "query": {
        "model": "sales"
      }
    },
    "plain": {
      "type": "metric",
      "label": "Revenue",
      "format": "compact",
      "encodings": {
        "value": "orders.net_revenue"
      },
      "query": {
        "model": "sales"
      }
    }
  },
  "layouts": [
    {
      "name": "desk",
      "type": "reflow",
      "default": true,
      "grid": {
        "columns": 12
      },
      "tiles": [
        {
          "widget": "revenue",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 2
        },
        {
          "widget": "share",
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 2
        },
        {
          "widget": "plain",
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 2
        },
        {
          "widget": "by_month",
          "x": 0,
          "y": 2,
          "w": 12,
          "h": 4
        }
      ]
    }
  ]
}
