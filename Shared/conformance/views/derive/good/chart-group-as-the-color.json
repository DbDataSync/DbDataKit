{
  "parameters": [],
  "groups": {
    "period": {
      "fields": [
        "orders.ordered_at_year",
        {
          "field": "orders.ordered_at_month",
          "format": {
            "date": "MMM"
          }
        }
      ],
      "label": "Period",
      "template": "{2} {1}"
    }
  },
  "widgets": {
    "w": {
      "type": "chart",
      "mark": "bar",
      "encodings": {
        "x": "products.category",
        "y": "orders.net_revenue",
        "color": {
          "group": "period",
          "title": "When"
        }
      },
      "query": {
        "model": "sales_catalog"
      }
    }
  },
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "attributes": [
        "products.category",
        "orders.ordered_at_year",
        "orders.ordered_at_month"
      ],
      "limit": 500
    }
  }
}
