{
  "parameters": [],
  "widgets": {
    "w": {
      "type": "chart",
      "mark": "bar",
      "encodings": {
        "x": "products.category",
        "y": [
          {
            "field": "orders.net_revenue",
            "alias": "open_revenue",
            "filters": [
              {
                "attribute": "orders.status",
                "operator": "equals",
                "values": [
                  "Open",
                  "Pending"
                ]
              }
            ],
            "title": "Open"
          },
          {
            "field": "orders.net_revenue",
            "alias": "completed_revenue",
            "filters": [
              {
                "attribute": "orders.status",
                "operator": "equals",
                "values": [
                  "Completed"
                ]
              }
            ],
            "title": "Completed"
          }
        ]
      },
      "query": {
        "model": "sales_catalog"
      }
    }
  },
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "open_revenue",
          "filters": [
            {
              "attribute": "orders.status",
              "operator": "equals",
              "values": [
                "Open",
                "Pending"
              ]
            }
          ]
        },
        {
          "measure": "orders.net_revenue",
          "as": "completed_revenue",
          "filters": [
            {
              "attribute": "orders.status",
              "operator": "equals",
              "values": [
                "Completed"
              ]
            }
          ]
        }
      ],
      "attributes": [
        "products.category"
      ],
      "limit": 500
    }
  }
}
