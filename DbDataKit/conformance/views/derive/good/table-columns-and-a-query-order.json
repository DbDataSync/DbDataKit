{
  "parameters": [
    "region"
  ],
  "widgets": {
    "w": {
      "type": "table",
      "title": "Orders",
      "encodings": {
        "columns": [
          {
            "field": "products.category",
            "label": "Category"
          },
          {
            "field": "products.product"
          },
          {
            "field": "orders.order_count",
            "align": "right"
          },
          {
            "field": "orders.net_revenue",
