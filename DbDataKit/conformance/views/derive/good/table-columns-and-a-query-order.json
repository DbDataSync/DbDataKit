        "products.product"
      ],
      "filters": [
        {
          "attribute": "customers.region",
          "operator": "equals",
          "values": {
            "param": "region"
          }
        }
      ],
      "order": [
        [
          "orders.net_revenue",
          "desc"
        ]
      ],
