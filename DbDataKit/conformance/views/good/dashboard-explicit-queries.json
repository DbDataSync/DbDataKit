{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Explicit queries",
  "parameters": [
    {
      "name": "quarter",
      "type": "string",
      "default": "FY27-Q1"
    },
    {
      "name": "top",
      "type": "integer",
      "default": 10
    }
  ],
  "widgets": {
    "semantic": {
      "type": "chart",
      "mark": "line",
      "encodings": {
        "x": "date.fiscal_month",
        "y": "orders.net_revenue",
        "color": "prior"
      },
      "query": {
        "mode": "explicit",
        "semantic": {
          "model": "sales",
          "request": {
            "measures": [
              "orders.net_revenue",
              {
                "measure": "orders.net_revenue",
                "as": "prior",
                "filters": [
                  {
                    "attribute": "date.fiscal_quarter",
                    "operator": "equals",
                    "values": [
                      {
                        "param": "quarter"
                      }
                    ]
                  }
                ]
              }
            ],
            "attributes": [
              "date.fiscal_month"
            ],
            "limit": {
              "param": "top"
            }
          }
        }
      }
    },
    "sql": {
      "type": "table",
      "encodings": {
        "columns": [
          {
            "field": "region"
          },
          {
            "field": "revenue"
          }
        ]
      },
      "query": {
        "mode": "explicit",
        "semantic": {
          "model": "sales",
          "sql": "select customers.region as region, sum(orders.net_revenue) as revenue from sales group by 1"
        }
      }
    },
    "saved": {
      "type": "metric",
      "encodings": {
        "value": "total"
      },
      "query": {
        "mode": "explicit",
        "saved": "total_revenue",
        "outputs": [
          "total"
        ],
        "params": {
          "quarter": "quarter"
        }
      }
    },
    "store": {
      "type": "table",
      "encodings": {
        "columns": [
          {
            "field": "id"
          },
          {
            "field": "name"
          }
        ]
      },
      "query": {
        "mode": "explicit",
        "store": {
          "model": "crm",
          "entity": "accounts",
          "columns": [
            "id",
            "name"
          ],
          "limit": 50
        }
      }
    },
    "answer": {
      "type": "matrix",
      "encodings": {
        "rows": [
          "region"
        ],
        "values": [
          {
            "field": "revenue"
          }
        ]
      },
      "query": {
        "mode": "explicit",
        "ref": "result.assistant_1",
        "outputs": [
          "region",
          "revenue"
        ]
      }
    }
  },
  "layouts": [
    {
      "name": "desk",
      "type": "reflow",
      "default": true,
      "grid": {
        "columns": 12
      },
      "tiles": [
        {
          "widget": "semantic",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "widget": "sql",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "widget": "saved",
          "x": 0,
          "y": 4,
          "w": 3,
          "h": 2
        },
        {
          "widget": "store",
          "x": 3,
          "y": 4,
          "w": 5,
          "h": 3
        },
        {
          "widget": "answer",
          "x": 8,
          "y": 4,
          "w": 4,
          "h": 4
        }
      ]
    }
  ]
}
