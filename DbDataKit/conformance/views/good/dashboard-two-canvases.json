{
  "schemaVersion": 1,
  "kind": "dashboard",
  "title": "Two canvases",
  "parameters": [
    {
      "name": "region",
      "type": "string",
      "for": "customers.region",
      "many": true,
      "default": [],
      "label": "Region"
    },
    {
      "name": "quarter",
      "type": "string",
      "for": "date.fiscal_quarter",
      "default": "FY27-Q1"
    }
  ],
  "widgets": {
    "revenue": {
      "type": "metric",
      "label": "Revenue",
      "format": "compact",
      "encodings": {
        "value": "orders.net_revenue",
        "compare": "orders.net_revenue_prev"
      },
      "query": {
        "model": "sales",
        "filters": [
          {
            "attribute": "date.fiscal_quarter",
            "operator": "equals",
            "values": [
              {
                "param": "quarter"
              }
            ]
          },
          {
            "attribute": "customers.region",
            "operator": "in",
            "values": {
              "param": "region"
            }
          }
        ]
      }
    },
    "by_region": {
      "type": "chart",
      "title": "Revenue by region",
      "mark": "bar",
      "encodings": {
        "x": "customers.region",
        "y": {
          "field": "orders.net_revenue",
          "type": "quantitative",
          "stack": null
        },
        "color": "products.category"
      },
      "query": {
        "model": "sales",
        "order": [
          [
            "orders.net_revenue",
            "desc"
          ]
        ],
        "limit": 20
      },
      "on_select": {
        "set": "region",
        "from": "customers.region"
      },
      "drill": {
        "to": {
          "report": "region_detail"
        },
        "with": {
          "region": "$customers.region",
          "quarter": "$params.quarter"
        }
      }
    }
  },
  "layouts": [
    {
      "name": "hd",
      "type": "canvas",
      "default": true,
      "canvas": {
        "width": 1920,
        "height": 1080
      },
      "overflow": "scale",
      "tiles": [
        {
          "widget": "revenue",
          "x": 40,
          "y": 40,
          "w": 400,
          "h": 180
        },
        {
          "widget": "by_region",
          "x": 40,
          "y": 260,
          "w": 1200,
          "h": 700
        }
      ]
    },
    {
      "name": "small",
      "type": "canvas",
      "when": {
        "width": {
          "max": 1500
        }
      },
      "canvas": {
        "width": 1280,
        "height": 720
      },
      "overflow": "scroll",
      "tiles": [
        {
          "widget": "revenue",
          "x": 20,
          "y": 20,
          "w": 300,
          "h": 140
        },
        {
          "widget": "by_region",
          "x": 20,
          "y": 180,
          "w": 800,
          "h": 500
        }
      ]
    },
    {
      "name": "sheet",
      "type": "canvas",
      "when": {
        "medium": "export"
      },
      "canvas": {
        "width": 297,
        "height": 210,
        "unit": "mm"
      },
      "overflow": "scale",
      "tiles": [
        {
          "widget": "revenue",
          "x": 10,
          "y": 10,
          "w": 60,
          "h": 30
        },
        {
          "widget": "by_region",
          "x": 10,
          "y": 50,
          "w": 200,
          "h": 100
        }
      ]
    }
  ]
}
