<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Real servers in one run (plan 13a, T12): Gateways and a runner as the programs they are (Sync runs on the runner: the `dbdatasync package publish` verb writes the package and the runner client sends it), started from their built output, with a console in this process between them. The programs are not
    project references on purpose: this project builds on its own, and the job that runs it (dbdatakit-ci.yml, `servers`) builds them first, as the Playwright job does. (The Build server's publishing tests went with it, plan 33 SC23.)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="..\..\src\DbDataKit.Server\DbDataKit.Server.csproj" />
    <ProjectReference Include="..\..\..\DbDataStore\src\DbDataStore.Server\DbDataStore.Server.csproj" />   <!-- the dbdatastore runtime, installed on a real runner (plan 33 SC24) -->
    <ProjectReference Include="..\..\..\DbDataWorkspace\src\DbDataWorkspace.Server\DbDataWorkspace.Server.csproj" />   <!-- a real Workspace server in this process: the trace across the relay (plan 22a GP29) -->
    <ProjectReference Include="..\..\..\DbDataGateway\src\DbDataGateway.Core\DbDataGateway.Core.csproj" />   <!-- the Flight client (a library; the Gateway itself is still the program) -->
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Runner.Client" />   <!-- the client that sends the replication set and asks a runner what only a paired client may (plan 33 SC23d2) -->
    <!-- the vendored package store an app build uses (made from the web workspace once per run, or DBDATAKIT_TEST_APP_STORE), as the Gateway's and the Workspace's tests take it -->
    <Compile Include="..\..\..\DbDataGateway\tests\DbDataGateway.Tests\Support\AppStoreSupport.cs" Link="Support\AppStoreSupport.cs" />
  </ItemGroup>
</Project>
