<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Real servers in one run (plan 13a, T12): a Build server and a Gateway as the programs they are, started from their built output, with a console in this process between them. The two programs are not
    project references on purpose: this project builds on its own, and the job that runs it (dbdatakit-ci.yml, `servers`) builds Build's and the Gateway's first, as the Playwright job does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="..\..\src\DbDataKit.Server\DbDataKit.Server.csproj" />
    <ProjectReference Include="..\..\..\DbDataGateway\src\DbDataGateway.Core\DbDataGateway.Core.csproj" />   <!-- the Flight client (a library; the Gateway itself is still the program) -->
    <DbDataKitReference Include="Secrets" />
  </ItemGroup>
</Project>
