[Unit]
Description=DbDataProxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/dbdataproxy/current/DbDataProxy.Server --urls https://0.0.0.0:8443
WorkingDirectory=/opt/dbdataproxy/current
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
WatchdogSec=30

# Identity
DynamicUser=yes
StateDirectory=dbdataproxy
ConfigurationDirectory=dbdataproxy
LogsDirectory=dbdataproxy
LoadCredential=api-key:/etc/dbdataproxy/secrets/api-key
LoadCredential=pfx-password:/etc/dbdataproxy/secrets/pfx-password
Environment="DOTNET_ENVIRONMENT=Production"

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
