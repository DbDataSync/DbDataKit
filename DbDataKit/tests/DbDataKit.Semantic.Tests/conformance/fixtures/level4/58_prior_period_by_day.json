{
  "name": "58_prior_period_by_day",
  "level": 4,
  "description": "By day: each earlier day takes the label of the current day it corresponds to (2025-07-01 is shown as 2026-07-01).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          },
          "output": "value"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.calendar_date"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-08-31"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_calendar_date": "2026-07-01",
        "orders_net_revenue": 250,
        "rev_prior": 390
      },
      {
        "date_calendar_date": "2026-08-01",
        "orders_net_revenue": 390,
        "rev_prior": 160
      }
    ]
  }
}
