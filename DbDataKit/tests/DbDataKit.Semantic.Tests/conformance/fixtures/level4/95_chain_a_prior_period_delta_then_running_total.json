{
  "name": "95_chain_a_prior_period_delta_then_running_total",
  "level": 4,
  "description": "A prior_period delta adds up when its measure does, so it can be accumulated: the year-on-year change so far is -140, then -140 + 230 = 90, then 200 (cumulative revenue 250, 640, 900 less last year's 390, 550, 700).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_delta",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "delta",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          }
        },
        {
          "as": "delta_cum",
          "transform": "running_total",
          "measure": "rev_delta",
          "along": "date.fiscal_month"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "rev_delta": -140,
        "delta_cum": -140
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "rev_delta": 230,
        "delta_cum": 90
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "rev_delta": 110,
        "delta_cum": 200
      }
    ]
  }
}
