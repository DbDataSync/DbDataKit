{
  "name": "56_window_year_to_date",
  "level": 4,
  "description": "Revenue for each month and for the fiscal year so far at that month: 250, then 250 + 390, then 640 + 260. The period is asked of the source at each month, not added up from the rows shown.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "ytd",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "start": {
            "period_start": "date.fiscal_year"
          },
          "end": "current"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_year",
          "operator": "equals",
          "values": [
            "FY27"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "ytd": 250
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "ytd": 640
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "ytd": 900
      }
    ]
  }
}
