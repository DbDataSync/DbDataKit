{
  "name": "18_allocate_by_measure_needs_measure",
  "level": 4,
  "description": "Allocating by measure has to say which measure.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "measure": "budget.budget_amount",
          "spread": {
            "allocate": {
              "by": "measure"
            }
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "errors_include": [
      "schema_invalid"
    ]
  }
}
