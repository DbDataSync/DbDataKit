{
  "name": "112_index_with_a_scale_of_one",
  "level": 4,
  "description": "scale 1 makes the base read 1 and the index a plain ratio: 250 / 250, 390 / 250 and 260 / 250.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "growth",
          "transform": "index",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "base": "2026-07",
          "scale": 1
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": [
        {
          "attribute": "date.fiscal_year",
          "operator": "equals",
          "values": [
            "FY27"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "growth": 1.0
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "growth": 1.56
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "growth": 1.04
      }
    ]
  }
}
