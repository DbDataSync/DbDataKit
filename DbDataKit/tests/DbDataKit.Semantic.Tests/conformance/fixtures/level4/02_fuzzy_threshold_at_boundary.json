  "expect": {
    "status": "complete",
    "result_sets": [
      {
        "id": "map_terr_region",
        "rows": [
          {
            "from": "Wesst",
            "to": "West",
            "confidence": 0.9533,
            "method": "fuzzy"
          }
        ]
      }
    ]
  }
}
