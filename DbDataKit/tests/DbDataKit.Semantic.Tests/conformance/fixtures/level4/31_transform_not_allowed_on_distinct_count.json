{
  "name": "31_transform_not_allowed_on_distinct_count",
  "level": 4,
  "description": "A share of a distinct count isn't meaningful: its rollup rule says it can't be added across products.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "as": "share",
          "transform": "pct_of_total",
          "measure": "orders.order_count",
          "over": [
            "products.product"
          ]
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "transform_not_allowed"
    ]
  }
}
