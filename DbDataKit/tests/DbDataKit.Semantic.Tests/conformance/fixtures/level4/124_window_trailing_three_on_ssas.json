{
  "name": "124_window_trailing_three_on_ssas",
  "level": 4,
  "description": "Trailing three members of the date table (which skips 2025-10 to 2026-06): 2026-07 reaches back to 2025-08 and 2025-09.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "limit": 100,
      "measures": [
        "budget.budget_amount",
        {
          "as": "r3",
          "transform": "window",
          "measure": "budget.budget_amount",
          "along": "date.fiscal_month",
          "start": -2,
          "end": "current"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "budget_budget_amount": 350.0,
        "r3": 850.0
      },
      {
        "date_fiscal_month": "2026-08",
        "budget_budget_amount": 350.0,
        "r3": 970.0
      },
      {
        "date_fiscal_month": "2026-09",
        "budget_budget_amount": 400.0,
        "r3": 1100.0
      }
    ]
  }
}
