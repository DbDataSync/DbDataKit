{
  "name": "12_allocate_equal_present_follows_filter",
  "level": 4,
  "description": "With the query filtered to product A, only A is present in the other inputs, so it takes the whole budget.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "measure": "budget.budget_amount",
          "spread": {
            "allocate": {
              "by": "equal",
              "members": "present"
            }
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        },
        {
          "attribute": "products.product",
          "operator": "equals",
          "values": [
            "A"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "orders_net_revenue": 100,
        "budget_budget_amount": 500
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "budget_budget_amount": 600
      }
    ]
  }
}
