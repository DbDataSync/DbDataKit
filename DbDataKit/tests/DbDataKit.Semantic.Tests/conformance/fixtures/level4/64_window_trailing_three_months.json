{
  "name": "64_window_trailing_three_months",
  "level": 4,
  "description": "Revenue for each month and for it and the two months before it, counted in the date table's order: 390, 550, 700, then 560 (150 + 250 + 160, not 2026-06 and 2026-05, which the table doesn't have), 790 and 900.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "r3",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "start": -2,
          "end": "current"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": []
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "r3": 390
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "r3": 550
      },
      {
        "date_fiscal_month": "2025-09",
        "orders_net_revenue": 150,
        "r3": 700
      },
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "r3": 560
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "r3": 790
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "r3": 900
      }
    ]
  }
}
