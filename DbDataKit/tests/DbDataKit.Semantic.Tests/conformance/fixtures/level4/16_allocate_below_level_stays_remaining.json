{
  "name": "16_allocate_below_level_stays_remaining",
  "level": 3,
  "description": "A level 3 engine doesn't allocate: the entry comes back as a remaining step with the base data.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "measure": "budget.budget_amount",
          "spread": {
            "allocate": {
              "by": "measure",
              "measure": "orders.net_revenue"
            }
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "partial",
    "reason_code": "level_not_implemented",
    "remaining": [
      {
        "step": 1,
        "op": "measure_expression",
        "reason": "level_not_implemented"
      },
      {
        "step": 2,
        "op": "finalize"
      }
    ]
  }
}
