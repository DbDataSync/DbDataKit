{
  "name": "38_prior_period_unknown_unit",
  "level": 4,
  "description": "The catalog's calendar can only move back by the units it declares.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "x",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_decade",
            "offset": -1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "unknown_period_unit"
    ]
  }
}
