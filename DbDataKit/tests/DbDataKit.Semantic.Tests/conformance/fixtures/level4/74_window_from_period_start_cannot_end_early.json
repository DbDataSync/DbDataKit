          },
          "end": -1
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": []
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "window_frame_invalid"
    ]
  }
