{
  "name": "57_prior_period_over_period_to_date",
  "level": 4,
  "description": "Fiscal quarter to date against the same days a year earlier: 2026-07-01 to 2026-09-15 moves back to 2025-07-01 to 2025-09-15.",
  "today": "2026-09-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          },
          "output": "value"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "period_to_date"
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "rev_prior": 390
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "rev_prior": 160
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "rev_prior": 150
      }
    ]
  }
}
