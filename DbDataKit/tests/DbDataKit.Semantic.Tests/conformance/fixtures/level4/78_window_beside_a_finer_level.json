{
  "name": "78_window_beside_a_finer_level",
  "level": 4,
  "description": "A day beside a window along the fiscal months has more than one value for each month, so it can't be read from the month.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "x",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "start": -1,
          "end": "current"
        }
      ],
      "attributes": [
        "date.fiscal_month",
        "date.calendar_date"
      ],
      "limit": 100,
      "filters": []
    }
  },
  "expect": {
    "status": "failed",
    "errors": [
      "window_attribute_not_coarser"
    ]
  }
}
