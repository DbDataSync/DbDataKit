{
  "name": "80_window_previous_member",
  "level": 4,
  "description": "offset -1 is the previous member of the date table, the shorthand for a window with start and end both -1 (lag): each month shows the month before it, and the first month has none, so it is blank. 2026-07's previous member is 2025-09, since the table has no months between.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "prev",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "offset": -1
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": []
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "prev": null
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "prev": 390
      },
      {
        "date_fiscal_month": "2025-09",
        "orders_net_revenue": 150,
        "prev": 160
      },
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "prev": 150
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "prev": 250
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "prev": 390
      }
    ]
  }
}
