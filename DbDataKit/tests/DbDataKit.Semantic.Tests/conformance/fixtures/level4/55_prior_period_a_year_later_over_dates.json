{
  "name": "55_prior_period_a_year_later_over_dates",
  "level": 4,
  "description": "A between on dates moves a year forward through the date table's counterparts, day by day: July and August 2025 against July and August 2026.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "later",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_year",
            "offset": 1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "between",
          "values": [
            "2025-07-01",
            "2025-08-31"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "later": 250
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "later": 390
      }
    ]
  }
}