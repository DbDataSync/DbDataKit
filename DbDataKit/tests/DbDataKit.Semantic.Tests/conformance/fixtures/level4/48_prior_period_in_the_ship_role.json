{
  "name": "48_prior_period_in_the_ship_role",
  "level": 4,
  "description": "Revenue by ship month against the same ship months a year earlier. The calendar moves ship_date.fiscal_month back through ship_date.fiscal_month_prior_year, so the earlier year is read by ship date too, and the filter on ship_date.fiscal_quarter moves back with it.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "output": "value",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "ship_date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "ship_date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "ship_date_fiscal_month": "2026-08",
        "orders_net_revenue": 250,
        "rev_prior": 390
      },
      {
        "ship_date_fiscal_month": "2026-09",
        "orders_net_revenue": 650,
        "rev_prior": 310
      }
    ]
  }
}