{
  "name": "111_index_on_a_datetime",
  "level": 4,
  "description": "The months an order was placed (in Chicago) through the date table, indexed to 2026-07 (150): 270 and 180 are 180 and 120. 2026-07 isn't shown but is the base.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "growth",
          "transform": "index",
          "measure": "orders.net_revenue",
          "along": "orders.ordered_at_fiscal_month",
          "base": "2026-07"
        }
      ],
      "attributes": [
        "orders.ordered_at_fiscal_month"
      ],
      "limit": 100,
      "filters": [
        {
          "attribute": "orders.ordered_at_fiscal_month",
          "operator": "equals",
          "values": [
            "2026-08",
            "2026-09"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_fiscal_month": "2026-08",
        "orders_net_revenue": 270,
        "growth": 180.0
      },
      {
        "orders_ordered_at_fiscal_month": "2026-09",
        "orders_net_revenue": 180,
        "growth": 120.0
      }
    ]
  }
}
