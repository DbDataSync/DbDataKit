{
  "name": "123_window_year_to_date_on_ssas",
  "level": 4,
  "description": "Fiscal year to date of the SSAS budget at each month of FY27-Q1: 350, 700, 1100. The year comes from the model's Date table.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "limit": 100,
      "measures": [
        "budget.budget_amount",
        {
          "as": "ytd",
          "transform": "window",
          "measure": "budget.budget_amount",
          "along": "date.fiscal_month",
          "start": {
            "period_start": "date.fiscal_year"
          },
          "end": "current"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "budget_budget_amount": 350.0,
        "ytd": 350.0
      },
      {
        "date_fiscal_month": "2026-08",
        "budget_budget_amount": 350.0,
        "ytd": 700.0
      },
      {
        "date_fiscal_month": "2026-09",
        "budget_budget_amount": 400.0,
        "ytd": 1100.0
      }
    ]
  }
}
