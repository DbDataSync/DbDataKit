{
  "name": "94_chain_with_a_post_filter",
  "level": 4,
  "description": "A post-filter can name the output of the last step of a chain: months whose cumulative share has reached 70%.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "share",
          "transform": "pct_of_total",
          "measure": "orders.net_revenue",
          "over": [
            "date.fiscal_month"
          ]
        },
        {
          "as": "cum_share",
          "transform": "running_total",
          "measure": "share",
          "along": "date.fiscal_month"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "post_filters": [
        {
          "measure": "cum_share",
          "operator": "gte",
          "values": [
            0.7
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "share": 0.433333333333333,
        "cum_share": 0.711111111111111
      },
      {
        "date_fiscal_month": "2026-09",
        "orders_net_revenue": 260,
        "share": 0.288888888888889,
        "cum_share": 1.0
      }
    ]
  }
}
