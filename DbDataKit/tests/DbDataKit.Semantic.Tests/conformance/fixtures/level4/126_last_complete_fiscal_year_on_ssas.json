{
  "name": "126_last_complete_fiscal_year_on_ssas",
  "level": 4,
  "description": "On 2026-08-15 the last complete fiscal year is FY26; its SSAS budget is 720. The fiscal year is a column of the Date table.",
  "today": "2026-08-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "limit": 100,
      "measures": [
        "budget.budget_amount"
      ],
      "attributes": [
        "date.fiscal_year"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_year",
          "operator": "last_complete",
          "count": 1
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_year": "FY26",
        "budget_budget_amount": 720.0
      }
    ]
  }
}
