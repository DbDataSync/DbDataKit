{
  "name": "130_ssas_last_complete_months",
  "level": 4,
  "description": "The last two complete fiscal months on the SSAS source: the engine reads the months and their days from the date table to resolve them.",
  "today": "2026-09-10",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "budget.budget_amount"
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "last_complete",
          "count": 2
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "budget_budget_amount": 300
      },
      {
        "customers_region": "West",
        "budget_budget_amount": 400
      }
    ]
  }
}
