{
  "name": "84_window_first_member_is_blank",
  "level": 4,
  "description": "Shown alone, the first month of the data has no previous member: its window is empty and the value, the delta and the percent change are all blank, not zero.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "prev",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "offset": -1
        },
        {
          "as": "change",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "offset": -1,
          "output": "delta"
        },
        {
          "as": "growth",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "offset": -1,
          "output": "pct_change"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "limit": 100,
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "equals",
          "values": [
            "2025-07"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "prev": null,
        "change": null,
        "growth": null
      }
    ]
  }
}
