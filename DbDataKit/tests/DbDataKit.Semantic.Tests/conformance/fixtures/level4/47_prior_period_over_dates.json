{
  "name": "47_prior_period_over_dates",
  "level": 4,
  "description": "A between on dates moves back through the calendar's day counterparts. The filter ends on 2026-08-31, which the sample date table has no row for, so it moves to the last day inside the filter (2026-08-15), whose counterpart is 2025-08-15.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_prior",
          "transform": "prior_period",
          "measure": "orders.net_revenue",
          "period": {
            "unit": "fiscal_year",
            "offset": -1
          },
          "output": "value"
        }
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-08-31"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250,
        "rev_prior": 390
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390,
        "rev_prior": 160
      }
    ]
  }
}
