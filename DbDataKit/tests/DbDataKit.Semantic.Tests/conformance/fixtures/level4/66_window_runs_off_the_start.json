{
  "name": "66_window_runs_off_the_start",
  "level": 4,
  "description": "The window for the first month of the data has nothing before it: 2025-07 with a window of three months is only 2025-07 itself (390), and 2025-08 adds one earlier month (550). The months before the data are not counted as zero or as missing.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "r3",
          "transform": "window",
          "measure": "orders.net_revenue",
          "along": "date.fiscal_month",
          "start": -2,
          "end": "current"
        }
      ],
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_month",
          "operator": "equals",
          "values": [
            "2025-07",
            "2025-08"
          ]
        }
      ],
      "limit": 100
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390,
        "r3": 390
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160,
        "r3": 550
      }
    ]
  }
}
