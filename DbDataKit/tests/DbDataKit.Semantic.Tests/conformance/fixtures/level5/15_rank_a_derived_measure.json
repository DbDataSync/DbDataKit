{
  "name": "15_rank_a_derived_measure",
  "level": 5,
  "description": "A transform can take a derived measure as its base: rank the regions by average order value.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.avg_order_value",
        {
          "as": "aov_rank",
          "transform": "rank",
          "measure": "orders.avg_order_value"
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "orders_avg_order_value": 100,
        "aov_rank": 1
      },
      {
        "customers_region": "West",
        "orders_avg_order_value": 83.33333333333333,
        "aov_rank": 2
      }
    ]
  }
}
