{
  "name": "09_rollup_override_empty_zero",
  "level": 5,
  "description": "With empty zero, a month without a value counts as zero. The months in scope are those with cancelled orders at all (Aug and Sep), so West is 80 over two months and East 100 over two.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "avg_monthly_revenue",
          "rollup": {
            "date.fiscal_month": "avg"
          },
          "empty": "zero"
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        },
        {
          "attribute": "orders.status",
          "operator": "equals",
          "values": [
            "Cancelled"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "avg_monthly_revenue": 50
      },
      {
        "customers_region": "West",
        "avg_monthly_revenue": 40
      }
    ]
  }
}
