{
  "name": "08_rollup_override_empty_skip",
  "level": 5,
  "description": "By default an average runs over the months that have a value: West's one cancelled month (80) and East's (100).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "avg_monthly_revenue",
          "rollup": {
            "date.fiscal_month": "avg"
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        },
        {
          "attribute": "orders.status",
          "operator": "equals",
          "values": [
            "Cancelled"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "avg_monthly_revenue": 100
      },
      {
        "customers_region": "West",
        "avg_monthly_revenue": 80
      }
    ]
  }
}
