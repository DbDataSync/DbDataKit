{
  "name": "16_rollup_over_two_attributes",
  "level": 5,
  "description": "Two dimensions rolled up, in order: the products are added within each month, then the months averaged. Revenue by region and month is West 150, 190, 160 and East 100, 200, 100, so the averages match level5/07.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        {
          "measure": "orders.net_revenue",
          "as": "avg_monthly_revenue",
          "rollup": {
            "products.product": "sum",
            "date.fiscal_month": "avg"
          }
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "avg_monthly_revenue": 133.33333333333334
      },
      {
        "customers_region": "West",
        "avg_monthly_revenue": 166.66666666666666
      }
    ]
  }
}
