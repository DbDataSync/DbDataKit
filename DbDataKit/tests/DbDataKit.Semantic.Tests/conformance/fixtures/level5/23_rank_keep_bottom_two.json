{
  "name": "23_rank_keep_bottom_two",
  "level": 5,
  "description": "order asc ranks from the smallest, so keep 2 is the bottom two: East A (100) and West B (200).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "rev_rank",
          "transform": "rank",
          "measure": "orders.net_revenue",
          "order": "asc",
          "keep": 2
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "orders_net_revenue": 100,
        "rev_rank": 1
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_net_revenue": 200,
        "rev_rank": 2
      }
    ]
  }
}
