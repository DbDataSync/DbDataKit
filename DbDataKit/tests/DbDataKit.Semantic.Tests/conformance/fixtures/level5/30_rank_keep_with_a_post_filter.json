{
  "name": "30_rank_keep_with_a_post_filter",
  "level": 5,
  "description": "The ranks are computed over all four rows, then keep and the post filter both apply: keep 3 leaves East B, West A and West B, and the share filter drops West B.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "share",
          "transform": "pct_of_total",
          "measure": "orders.net_revenue",
          "over": [
            "customers.region",
            "products.product"
          ]
        },
        {
          "as": "rev_rank",
          "transform": "rank",
          "measure": "orders.net_revenue",
          "keep": 3
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "post_filters": [
        {
          "measure": "share",
          "operator": "gte",
          "values": [
            0.3
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300,
        "share": 0.3333333333333333,
        "rev_rank": 1
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "share": 0.3333333333333333,
        "rev_rank": 1
      }
    ]
  }
}
