{
  "name": "18_both_roles_of_one_dimension",
  "level": 2,
  "description": "Order month and ship month together: each role is its own join of the same table.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month",
        "ship_date.fiscal_month"
      ],
      "filters": [
