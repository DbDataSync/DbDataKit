{
  "name": "29_not_contains_on_an_ssas_source",
  "level": 2,
  "description": "Budget by region for regions that do not contain 'es' (West does): a blank is dropped, as SQL drops a NULL under NOT LIKE.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "budget.budget_amount"
      ],
      "limit": 100,
      "attributes": [
        "customers.region"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        },
        {
          "attribute": "customers.region",
          "operator": "not_contains",
          "values": [
            "es"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "budget_budget_amount": 500
      }
    ],
    "native_query_contains": {
      "d1": [
        "NOT ISBLANK ( 'Customer'[Region] )",
        "NOT CONTAINSSTRING ( 'Customer'[Region], \"es\" )"
      ]
    }
  }
}
