{
  "name": "06_transform_stays_partial",
  "level": 2,
  "description": "Transforms are above level 2: the base data comes back with a measure_expression step, as at level 1.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        {
          "as": "pct_of_region",
          "transform": "pct_of_total",
          "measure": "orders.net_revenue",
          "over": [
            "products.product"
          ]
        }
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "partial",
    "result_sets": [
      {
        "id": "d1",
        "grain": [
          "customers.region",
          "products.product"
        ]
      }
    ],
    "remaining": [
      {
        "step": 1,
        "op": "measure_expression",
        "reason": "level_not_implemented"
      },
      {
        "step": 2,
        "op": "finalize"
      }
    ]
  }
}
