{
  "name": "04_limit_truncates_after_combine",
  "level": 2,
  "description": "Order and limit apply to the combined rows, with the dimension tiebreak, and the descriptor reports truncation.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        "budget.budget_amount"
      ],
      "limit": 3,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "order": [
        [
          "orders.net_revenue",
          "desc"
        ]
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300,
        "budget_budget_amount": 500
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300,
        "budget_budget_amount": 600
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_net_revenue": 200,
        "budget_budget_amount": 600
      }
    ],
    "descriptor": {
      "x_truncated": true,
      "x_row_count": 3
    }
  }
}
