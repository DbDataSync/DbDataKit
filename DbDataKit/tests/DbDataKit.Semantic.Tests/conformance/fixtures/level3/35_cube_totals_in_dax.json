{
  "name": "35_cube_totals_in_dax",
  "level": 3,
  "description": "A cube in DAX: each listed dimension gets its own ROLLUPADDISSUBTOTAL flag, every combination is kept (no chain filter), and the level is looked up from the flags in the same numbering the engine uses. (The conformance run uses the DuckDB stand-in for this source; the DAX is checked as text.)",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "budget.budget_amount"
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "totals": {
        "subtotal_by": [
          "customers.region",
          "date.fiscal_month"
        ],
        "grand_total": true,
        "cube": true
      }
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
