{
  "name": "31_native_subtotals_keep_a_partition",
  "level": 3,
  "description": "Only the product is rolled up; the region partitions. The source's query is GROUP BY region, ROLLUP(product), the level map has two levels, and there is no grand total row.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        "orders.order_count"
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "totals": {
        "subtotal_by": [
          "products.product"
        ],
        "grand_total": false
      }
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 100,
        "orders_order_count": 1
      },
      {
        "customers_region": "East",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "orders_order_count": 3
      },
      {
        "customers_region": "East",
        "products_product": null,
        "_rollup_level": 1,
        "orders_net_revenue": 400,
        "orders_order_count": 4
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "orders_order_count": 3
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 200,
        "orders_order_count": 3
      },
      {
        "customers_region": "West",
        "products_product": null,
        "_rollup_level": 1,
        "orders_net_revenue": 500,
        "orders_order_count": 6
      }
    ],
    "descriptor": {
      "x_totals": {
        "level_field": "_rollup_level",
        "subtotal_by": [
          "products.product"
        ],
        "levels": [
          {
            "level": 0,
            "kind": "detail",
            "kept": [
              "customers.region",
              "products.product"
            ],
            "rolled_up": []
          },
          {
            "level": 1,
            "kind": "subtotal",
            "kept": [
              "customers.region"
            ],
            "rolled_up": [
              "products.product"
            ]
          }
        ]
      }
    },
    "native_query_contains": {
      "d1_g": [
        "GROUP BY",
        "ROLLUP(",
        "GROUPING("
      ]
    }
  }
}
