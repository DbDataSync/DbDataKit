{
  "name": "34_cube_totals",
  "level": 3,
  "description": "totals with cube: every subset of the listed dimensions is rolled up, so there are product totals across regions (level 1, the region rolled up) as well as region totals across products (level 2). Levels are numbered by how many dimensions are rolled up, then by position, and the descriptor says what each one is. Distinct counts are recomputed for each set, never added.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue",
        "orders.order_count"
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "totals": {
        "subtotal_by": [
          "customers.region",
          "products.product"
        ],
        "grand_total": true,
        "cube": true
      }
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 100,
        "orders_order_count": 1
      },
      {
        "customers_region": "East",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "orders_order_count": 3
      },
      {
        "customers_region": "East",
        "products_product": null,
        "_rollup_level": 2,
        "orders_net_revenue": 400,
        "orders_order_count": 4
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "_rollup_level": 0,
        "orders_net_revenue": 300,
        "orders_order_count": 3
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "_rollup_level": 0,
        "orders_net_revenue": 200,
        "orders_order_count": 3
      },
      {
        "customers_region": "West",
        "products_product": null,
        "_rollup_level": 2,
        "orders_net_revenue": 500,
        "orders_order_count": 6
      },
      {
        "customers_region": null,
        "products_product": "A",
        "_rollup_level": 1,
        "orders_net_revenue": 400,
        "orders_order_count": 4
      },
      {
        "customers_region": null,
        "products_product": "B",
        "_rollup_level": 1,
        "orders_net_revenue": 500,
        "orders_order_count": 6
      },
      {
        "customers_region": null,
        "products_product": null,
        "_rollup_level": 3,
        "orders_net_revenue": 900,
        "orders_order_count": 10
      }
    ],
    "descriptor": {
      "x_totals": {
        "level_field": "_rollup_level",
        "levels": [
          {
            "level": 0,
            "kind": "detail",
            "kept": [
              "customers.region",
              "products.product"
            ],
            "rolled_up": []
          },
          {
            "level": 1,
            "kind": "subtotal",
            "kept": [
              "products.product"
            ],
            "rolled_up": [
              "customers.region"
            ]
          },
          {
            "level": 2,
            "kind": "subtotal",
            "kept": [
              "customers.region"
            ],
            "rolled_up": [
              "products.product"
            ]
          },
          {
            "level": 3,
            "kind": "grand_total",
            "kept": [],
            "rolled_up": [
              "customers.region",
              "products.product"
            ]
          }
        ]
      }
    },
    "native_query_contains": {
      "d1_g": [
        "CUBE(",
        "CASE "
      ]
    }
  }
}
