{
  "name": "24_lt_a_date",
  "level": 1,
  "description": "lt on a date is strictly earlier.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.calendar_date"
      ],
      "filters": [
        {
          "attribute": "date.calendar_date",
          "operator": "lt",
          "values": [
            "2026-01-01"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "result_sets": [
      {
        "id": "d1",
        "source": "sqlserver_sales",
        "grain": [
          "date.calendar_date"
        ],
        "covers": {
          "measures": [
            "orders.net_revenue"
          ],
          "filters_applied": [
            "date.calendar_date lt 2026-01-01"
          ],
          "filters_not_applied": []
        }
      }
    ],
    "remaining": [],
    "rows": [
      {
        "date_calendar_date": "2025-07-01",
        "orders_net_revenue": 390
      },
      {
        "date_calendar_date": "2025-08-01",
        "orders_net_revenue": 160
      },
      {
        "date_calendar_date": "2025-09-01",
        "orders_net_revenue": 150
      }
    ]
  }
}