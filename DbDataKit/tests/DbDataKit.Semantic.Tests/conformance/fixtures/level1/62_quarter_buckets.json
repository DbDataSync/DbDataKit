{
  "name": "62_quarter_buckets",
  "level": 1,
  "description": "Quarters are labeled year-Qn in the zone: order 1 (June 30 in Chicago) is in 2026-Q2 and the other FY27 orders in 2026-Q3.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_quarter"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at",
          "operator": "between",
          "values": [
            "2026-06-01",
            "2026-09-30"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_quarter": "2026-Q2",
        "orders_net_revenue": 100
      },
      {
        "orders_ordered_at_quarter": "2026-Q3",
        "orders_net_revenue": 800
      }
    ]
  }
}