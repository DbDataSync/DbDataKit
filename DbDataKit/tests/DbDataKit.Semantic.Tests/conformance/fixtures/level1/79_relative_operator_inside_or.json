{
  "name": "79_relative_operator_inside_or",
  "level": 1,
  "description": "A relative operator is an ordinary filter leaf: inside an or it resolves in place. The month before the current one (August) or July by name.",
  "today": "2026-09-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "or": [
            {
              "attribute": "date.fiscal_month",
              "operator": "last_complete",
              "count": 1
            },
            {
              "attribute": "date.fiscal_month",
              "operator": "equals",
              "values": [
                "2026-07"
              ]
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "resolved": [
      {
        "path": "$.query.filters[0].or[0]",
        "attribute": "date.fiscal_month",
        "operator": "last_complete",
        "members": [
          "2026-08"
        ]
      }
    ],
    "rows": [
      {
        "date_fiscal_month": "2026-07",
        "orders_net_revenue": 250
      },
      {
        "date_fiscal_month": "2026-08",
        "orders_net_revenue": 390
      }
    ]
  }
}
