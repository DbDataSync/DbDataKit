{
  "name": "02_order_limit_tiebreak",
  "level": 1,
  "description": "Limit cuts through a tie; the dimension tiebreak makes the cut deterministic.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 3,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ],
      "order": [
        [
          "orders.net_revenue",
          "desc"
        ]
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "remaining": [],
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_net_revenue": 200
      }
    ],
    "descriptor": {
      "x_truncated": true
    },
    "native_query_contains": {
      "d1": [
        "ORDER BY orders_net_revenue DESC, customers_region ASC, products_product ASC"
      ]
    }
  }
}