{
  "name": "59_between_dates_on_a_datetime",
  "level": 1,
  "description": "A datetime has no date table: the month bucket is the datetime's own attribute and the dates are read in the zone. July and August by Chicago months (order 1 falls in June and is outside the filter).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-08-31"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_month": "2026-07",
        "orders_net_revenue": 270
      },
      {
        "orders_ordered_at_month": "2026-08",
        "orders_net_revenue": 350
      }
    ]
  }
}