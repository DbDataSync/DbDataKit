{
  "name": "73_between_numbers",
  "level": 1,
  "description": "between works on a measure too, both ends included: for FY27-Q1, revenue from 150 to 300 leaves West A (300), West B (200) and East B (300) and drops East A (100).",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "customers.region",
        "products.product"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        },
        {
          "measure": "orders.net_revenue",
          "operator": "between",
          "values": [
            150,
            300
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "customers_region": "East",
        "products_product": "B",
        "orders_net_revenue": 300
      },
      {
        "customers_region": "West",
        "products_product": "A",
        "orders_net_revenue": 300
      },
      {
        "customers_region": "West",
        "products_product": "B",
        "orders_net_revenue": 200
      }
    ]
  }
}