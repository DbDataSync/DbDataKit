{
  "name": "60_relative_range_on_a_datetime",
  "level": 1,
  "description": "The last 2 complete months of a datetime, counted in the zone from the engine's clock (2026-09-15): July and August.",
  "today": "2026-09-15",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at_month",
          "operator": "last_complete",
          "count": 2
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_month": "2026-07",
        "orders_net_revenue": 270
      },
      {
        "orders_ordered_at_month": "2026-08",
        "orders_net_revenue": 350
      }
    ]
  }
}