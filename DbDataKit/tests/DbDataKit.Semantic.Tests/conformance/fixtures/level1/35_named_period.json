{
  "name": "35_named_period",
  "level": 1,
  "description": "A period by name is an ordinary equals on the period attribute: fiscal year FY26.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.fiscal_month"
      ],
      "filters": [
        {
          "attribute": "date.fiscal_year",
          "operator": "equals",
          "values": [
            "FY26"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "date_fiscal_month": "2025-07",
        "orders_net_revenue": 390
      },
      {
        "date_fiscal_month": "2025-08",
        "orders_net_revenue": 160
      },
      {
        "date_fiscal_month": "2025-09",
        "orders_net_revenue": 150
      }
    ]
  }
}
