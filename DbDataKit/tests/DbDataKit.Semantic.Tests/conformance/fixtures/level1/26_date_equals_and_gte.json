{
  "name": "26_date_equals_and_gte",
  "level": 1,
  "description": "Dates also take the comparison operators.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "date.calendar_date"
      ],
      "filters": [
        {
          "or": [
            {
              "attribute": "date.calendar_date",
              "operator": "equals",
              "values": [
                "2026-07-01"
              ]
            },
            {
              "attribute": "date.calendar_date",
              "operator": "gte",
              "values": [
                "2026-09-01"
              ]
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "result_sets": [
      {
        "id": "d1",
        "source": "sqlserver_sales",
        "grain": [
          "date.calendar_date"
        ],
        "covers": {
          "measures": [
            "orders.net_revenue"
          ],
          "filters_applied": [
            "(date.calendar_date equals 2026-07-01 or date.calendar_date gte 2026-09-01)"
          ],
          "filters_not_applied": []
        }
      }
    ],
    "remaining": [],
    "rows": [
      {
        "date_calendar_date": "2026-07-01",
        "orders_net_revenue": 250
      },
      {
        "date_calendar_date": "2026-09-01",
        "orders_net_revenue": 260
      }
    ]
  }
}
