{
  "name": "67_named_fiscal_quarter_on_a_datetime",
  "level": 1,
  "description": "A named fiscal quarter (equals on the quarter attribute read through a datetime), broken down by the date table's fiscal month. It applies to the datetime through its date.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "attributes": [
        "orders.ordered_at_fiscal_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at_fiscal_quarter",
          "operator": "equals",
          "values": [
            "FY27-Q1"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_fiscal_month": "2026-07",
        "orders_net_revenue": 150
      },
      {
        "orders_ordered_at_fiscal_month": "2026-08",
        "orders_net_revenue": 270
      },
      {
        "orders_ordered_at_fiscal_month": "2026-09",
        "orders_net_revenue": 180
      }
    ]
  }
}