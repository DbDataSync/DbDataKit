{
  "name": "57_month_in_the_requests_zone",
  "level": 1,
  "description": "The request's timezone overrides the catalog's. In UTC the same orders fall in July (250), August (390) and September (260), the months of their UTC dates.",
  "request": {
    "spec_version": "0.3",
    "kind": "query",
    "query": {
      "measures": [
        "orders.net_revenue"
      ],
      "limit": 100,
      "timezone": "UTC",
      "attributes": [
        "orders.ordered_at_month"
      ],
      "filters": [
        {
          "attribute": "orders.ordered_at",
          "operator": "between",
          "values": [
            "2026-07-01",
            "2026-09-30"
          ]
        }
      ]
    }
  },
  "expect": {
    "status": "complete",
    "ordered": true,
    "rows": [
      {
        "orders_ordered_at_month": "2026-07",
        "orders_net_revenue": 250
      },
      {
        "orders_ordered_at_month": "2026-08",
        "orders_net_revenue": 390
      },
      {
        "orders_ordered_at_month": "2026-09",
        "orders_net_revenue": 260
      }
    ]
  }
}