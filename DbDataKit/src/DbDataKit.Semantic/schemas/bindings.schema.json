{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/qis/bindings.schema.json",
  "title": "Column bindings",
  "description": "What each column of a registered table means, in catalog terms.",
  "type": "object",
  "required": [
    "kind",
    "table",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "0.3"
    },
    "kind": {
      "const": "bindings"
    },
    "table": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(@v[0-9]+)?$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "role": {
            "enum": [
              "attribute",
              "column",
              "weight"
            ]
          },
          "as": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "binds_to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "via_map": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "grain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmed_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
