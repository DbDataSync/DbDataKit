<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Views.Export</RootNamespace>
    <Description>The PDF exporter of dashboards and reports (plan 32 DBR15): one IReportExporter over PuppeteerSharp and a pinned Chromium (no Node, no download at run time, no network but the page's own files), the bundled font set, the strict views.export settings.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
</Project>
