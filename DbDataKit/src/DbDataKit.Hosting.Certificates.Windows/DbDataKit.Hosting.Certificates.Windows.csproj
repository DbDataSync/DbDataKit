<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DbDataKit.Hosting.Certificates.Windows</PackageId>
    <Description>Windows certificate store, installed private-key ACL and installed-service-account helpers for DbDataKit.Hosting.Certificates.</Description>
    <!--
      net10.0, not net10.0-windows: products that publish for Linux reference this package, so every member is marked
      [SupportedOSPlatform("windows")] instead and callers check OperatingSystem.IsWindows() first.
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DbDataKit.Hosting.Certificates\DbDataKit.Hosting.Certificates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DbDataKit.Hosting.Certificates.Windows.Tests" />
  </ItemGroup>
</Project>
