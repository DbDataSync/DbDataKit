<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dashboards and reports (plan 32): the shared core of the dashboard/1 and report/1 documents (widgets, parameters, layouts, selectors), their strict loaders with file and line diagnostics, and the pure selection of a layout.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- the schemas live with the shared visuals (web/visuals) and are embedded as they are; a test compares nothing because it is the same file -->
    <EmbeddedResource Include="..\..\web\visuals\schemas\core.schema.json" LogicalName="DbDataKit.Views.schemas.core.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\view.schema.json" LogicalName="DbDataKit.Views.schemas.view.schema.json" />
    <EmbeddedResource Include="..\..\web\visuals\schemas\vega-lite-subset.schema.json" LogicalName="DbDataKit.Views.schemas.vega-lite-subset.schema.json" />
    <ProjectReference Include="..\DbDataKit.Config.Yaml\DbDataKit.Config.Yaml.csproj" />
  </ItemGroup>
</Project>
