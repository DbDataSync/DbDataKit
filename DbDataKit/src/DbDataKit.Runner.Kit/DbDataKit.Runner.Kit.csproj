<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Runner.Kit</RootNamespace>
    <Description>The kit a .NET job is written against (plan 28b): RunnerJob, typed progress, steps, units and counters, the type-state step calls, and an in-process run on the real stores. Ships the analyzer that checks step and unit names.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1573;CS1572</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\DbDataKit.Runner.Abstractions\DbDataKit.Runner.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataKit.State\DbDataKit.State.csproj" />
    <!-- the analyzer is built first and travels in the package, under analyzers/ -->
    <ProjectReference Include="..\DbDataKit.Runner.Kit.Analyzers\DbDataKit.Runner.Kit.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\DbDataKit.Runner.Kit.Analyzers\bin\$(Configuration)\netstandard2.0\DbDataKit.Runner.Kit.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
