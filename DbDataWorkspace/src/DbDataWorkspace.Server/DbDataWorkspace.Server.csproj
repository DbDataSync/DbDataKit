<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>dbdataworkspace</AssemblyName>
    <Description>DbDataWorkspace: the server where people and agents author projects (apps today) in git workspaces, with a record of what was done (plan 22a GP31, plan 27).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar -->
    <DbDataKitReference Include="Authoring" />   <!-- the workspace list, create, abandon and git calls, the same for every project kind (GP30) -->
    <DbDataKitReference Include="Config.Git" />   <!-- a project's repository -->
    <DbDataKitReference Include="Hosting.Abstractions" />   <!-- the shared host: service and systemd modes, drain, /health and /version -->
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="State.Api" />   <!-- GET /api/v1/state and the maintenance mode; plan 29b, C05 -->
    <DbDataKitReference Include="State.Cli" />   <!-- state show, test and grants; plan 29b, C01 -->
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="State" />   <!-- the state database and the workspace module -->
    <DbDataKitReference Include="State.Engines" />   <!-- SQLite, SQL Server or PostgreSQL for the state -->
    <DbDataKitReference Include="Secrets.Abstractions" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Cli" />   <!-- the secret verbs; plan 29b, C06 -->
    <DbDataKitReference Include="Secrets.Store" />   <!-- this server's own store: the publisher's key -->
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Web" />   <!-- pairing, key rotation, the version header and the token check -->
  </ItemGroup>
</Project>
