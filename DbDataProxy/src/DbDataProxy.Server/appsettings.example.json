{
  // Copy the parts you need into appsettings.json. Settings can also come from environment variables
  // (DBPROXY_Proxy__Listen__Port=9000) or the command line (--Proxy:Listen:Port=9000).
  "Proxy": {
    // Configuration schema version (optional; absent means 1). 2 makes each data source's Classifier default to "strict" instead of "warn".
    // Keys are case-insensitive. A misspelt or unknown key stops the service at startup with exit code 2 (check a file with: DbDataProxy config check --file appsettings.json).
    "SchemaVersion": 2,

    // Secrets are references, not literals: env:NAME, file:PATH, secret:dbdata:proxy:..., dpapi:<base64> (see README, "Secrets").
    // A literal still works but logs a warning naming the key; true refuses to start with literal secrets.
    "RequireReferencedSecrets": false,

    // Clients never see the database driver's own error text (it can name tables, servers and paths): they get the failure kind, the engine's
    // error number or SQLSTATE and a fixed sentence, e.g. "The login was rejected. [sqlserver 18456]". With true (default) the server log also
    // gets the driver text (secrets scrubbed); false logs only kind and code.
    "LogDriverErrors": true,

    "Listen": { "Address": "0.0.0.0", "Port": 8815 },

    // SelfSigned: a certificate is generated on first start (and renewed near expiry or when names change) in
    // DataDirectory; import the .cer written beside it into clients that need to trust it.
    // File: use your own PFX.  Store: use a certificate from the certificate store.  None: plain HTTP/2 (local testing only - credentials travel in clear text).
    "Tls": {
      "Mode": "SelfSigned",
      "Hostnames": [ "proxy.example.com" ]
      // "Mode": "Store", "CertificateThumbprint": "<thumbprint>"  (or "CertificateSubject": "proxy.example.com"; "StoreLocation": "LocalMachine" or "CurrentUser")
      // "Mode": "File", "CertificatePath": "C:\certs\proxy.pfx", "CertificatePassword": "env:DBPROXY_PFX_PASSWORD"
      // The generated PFX gets a random password kept in a protected file beside it; leave CertificatePassword unset.
    },

    // "Hosting": { "MaxConcurrentRequests": 1000, "DrainSeconds": 30 },

    // Mode: None | Grpc (gRPC compression, gzip) | Arrow (Arrow data compression: zstd or lz4 inside the Arrow stream; best ratio).
    // Clients can override per call with the "x-compression" header (none, gzip, zstd, lz4) unless disabled here.
    "Compression": { "Mode": "Arrow", "Codec": "zstd", "Level": 3, "AllowClientOverride": true },

    // JWT with a shared HMAC key: "Jwt": { "SigningKey": "file:C:\secrets\jwt.key", "Audience": "api://dbproxy", "Mappings": [ ... ] }
    "Auth": { "SessionIdleMinutes": 30, "SessionMaxHours": 12, "AllowPassThrough": true },

    // Clients choose a data source with the "x-datasource" header; they never send connection strings.
    "DataSources": {
      "erp": {
        "Provider": "sqlserver",
        // SQL Server sources encrypt and verify the server certificate by default. TrustServerCertificate=True below is an EXPLICIT opt-out, kept
        // only as a demonstration: the setting is honoured as written, and the service logs one warning naming this source at every start.
        // Prefer a trusted certificate on the server and no TrustServerCertificate/Encrypt keys at all.
        "ConnectionString": "Server=SQL01;Database=Erp;User Id=proxy_reader;Password=env:ERP_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True",
        "CommandTimeoutSeconds": 300,
        // Optional limits, off by default (0): queries running at once on this source, and per user. A streaming result counts until it is read
        // or discarded. Requests wait up to AcquireTimeoutSeconds for a slot and are then refused with ResourceExhausted.
        "MaxConcurrentQueries": 20,
        "MaxConcurrentQueriesPerUser": 4,
        "AcquireTimeoutSeconds": 30,
        // Statement text check on this read-only source (AllowWrites false): "strict" (default from SchemaVersion 2) refuses statements that are not a
        // single SELECT or that use OPENROWSET, xp_*, COPY, ATTACH, read_csv, ... with PermissionDenied; "warn" (the default without SchemaVersion) only logs
        // them; "off" skips the check. Defence in depth only: also give the source a read-only database login.
        "Classifier": "strict"
      },
      "legacy": {
        // 32-bit ODBC drivers run in the bundled 32-bit worker process.
        "Provider": "odbc",
        "Bitness": "x86",
        "ConnectionString": "Driver={Some 32-bit Driver};Dsn=Legacy;",
        "Compression": { "Mode": "Arrow", "Codec": "lz4" }
      },
      "warehouse": {
        // Callers' own database credentials (the username/password they authenticate with) are used to connect.
        "Provider": "odbc",
        "PassThrough": true,
        // No TLS keys: the secure default applies (encrypt, verify the certificate). The credentials the caller sends replace any user/password here,
        // and any integrated-security keys (Trusted_Connection, Authentication=...) are removed before they are injected.
        "ConnectionString": "Driver={ODBC Driver 18 for SQL Server};Server=SQL02;Database=Dw"
      },
      "scratch": {
        "Provider": "duckdb",
        "ConnectionString": "Data Source=C:\\data\\scratch.duckdb",
        "AllowWrites": true
      },
      "lake": {
        // A DuckDB source without AllowWrites runs in a sandbox: the file is opened READ_ONLY, queries cannot read other files, ATTACH, COPY ... TO,
        // INSTALL or LOAD, and the settings are locked. AllowedDirectories is the one exception, for a source that deliberately serves a folder
        // of files (absolute paths; nothing else opens).
        "Provider": "duckdb",
        "ConnectionString": "Data Source=C:\\data\\lake.duckdb",
        "AllowedDirectories": [ "C:\\data\\parquet" ]
      }
    },

    // Generate hashes with: dbdataproxy secret hash
    "Users": [
      {
        "Name": "reporting",
        "PasswordHash": "PBKDF2-SHA256$210000$...$...",
        "DataSources": [ "erp", "legacy" ],
        "DefaultDataSource": "erp"
      }
    ]
  }
}
