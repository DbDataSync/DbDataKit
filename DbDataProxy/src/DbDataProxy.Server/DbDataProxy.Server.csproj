<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dbdataproxy</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Apache.Arrow.Flight.AspNetCore" />
    <PackageReference Include="Apache.Arrow.Flight.Sql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="DuckDB.NET.Data" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar; plan 13, C04 -->
    <DbDataKitReference Include="Serving.FlightSql" />   <!-- the Flight SQL wire module, moved out of this project (plan 19, N02) -->
    <DbDataKitReference Include="Semantic.Cli" />   <!-- the semantic noun of the command line; plan 19, J15 -->
    <DbDataKitReference Include="Serving.Semantic" />   <!-- semantic requests and semantic SQL over the data sources; plan 19, J10 -->
    <DbDataKitReference Include="Semantic.Ssas" />   <!-- Analysis Services sources of a semantic model (Windows only at run time); plan 19, J16 -->
    <DbDataKitReference Include="Connections.Abstractions" />   <!-- connection/1, the data source format; plan 13, E02 -->
    <DbDataKitReference Include="Connections.SqlServer" />
    <DbDataKitReference Include="Connections.FlightSql" />   <!-- an upstream Flight SQL server as a data source; plan 13a, P12 -->
    <DbDataKitReference Include="Connections.Postgres" />   <!-- PostgreSQL data sources; plan 13a, P12 -->
    <DbDataKitReference Include="Connections.DuckDb" />
    <DbDataKitReference Include="Store" />   <!-- the master data models a DbDataStore server publishes to the group, and their write path; plan 20 O10, O08 -->
    <DbDataKitReference Include="Config.Yaml" />
    <DbDataKitReference Include="Config" />
    <DbDataKitReference Include="Config.Hosting" />
    <DbDataKitReference Include="Secrets.Abstractions" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Secrets.Store" />
    <DbDataKitReference Include="Secrets.Cli" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <DbDataKitReference Include="Hosting.Abstractions" />
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Hosting.Children" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="State" />
    <DbDataKitReference Include="State.Api" />   <!-- GET /api/v1/state and the maintenance mode; plan 29b, C05 -->
    <DbDataKitReference Include="State.Cli" />   <!-- state show, test and grants; plan 29b, C01 -->
    <DbDataKitReference Include="State.Engines" />   <!-- SQLite, SQL Server or PostgreSQL for it, as the operator names; plan 13a, P11 -->   <!-- the proxy's state database; plan 13, P02 -->
    <DbDataKitReference Include="Web" />   <!-- the management API: pairing, tokens, roles; plan 13, P03 -->
    <DbDataKitReference Include="Apps.Bundling" />   <!-- apps build: the bundler behind a command line; plan 26, AP23 -->
    <DbDataKitReference Include="Views.Hosting" />   <!-- the views module: published dashboards and reports as the caller; plan 32, DBR11b -->
    <DbDataKitReference Include="Apps.Host" />   <!-- the apps module: published apps by subpath; plan 26, AP05 -->
    <DbDataKitReference Include="Identity" />   <!-- the identity home as a module; plan 20, O06 -->
    <DbDataKitReference Include="Config.Git" />   <!-- the configuration folder is a git repository; every change is a commit by the person who made it -->
    <DbDataKitReference Include="Hosting.Local" />   <!-- the local channel for the command line on this machine -->
    <ProjectReference Include="..\DbDataProxy.Core\DbDataProxy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DbDataProxy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- the sample apps `apps init` copies, inside the program: no repository and no network needed (plan 26, AP23) -->
    <EmbeddedResource Include="..\..\templates\apps\territory-notes\**\*" LogicalName="apps-templates/territory-notes/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\templates\apps\territory-notes-src\**\*" LogicalName="apps-templates/territory-notes-src/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\templates\apps\front-portal\**\*" LogicalName="apps-templates/front-portal/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\templates\apps\territory-views\**\*" LogicalName="apps-templates/territory-views/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!--
    The runtime that draws an app of views only (plan 26, AP25) is the web build of DbDataKit/web/view-app. A build copies it next to the program when it exists (so a developer who built it sees it run); publish builds it, unless
    SkipWebBuild is true, as the console does. Without it the host answers an app of views with a 503 that says how to build it.
  -->
  <PropertyGroup>
    <ViewsWebDir>$(MSBuildProjectDirectory)/../../../DbDataKit/web</ViewsWebDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ViewsWebDir)/view-app/dist/**" Link="apps-views/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildViewsRuntime" BeforeTargets="PrepareForPublish" Condition="'$(BuildViewsRuntime)' == 'true'">
    <Message Importance="high" Text="Building the views runtime in $(ViewsWebDir)" />
    <Exec Command="npm ci" WorkingDirectory="$(ViewsWebDir)" />
    <Exec Command="npm run build -w @dbdatakit/view-app" WorkingDirectory="$(ViewsWebDir)" />
    <ItemGroup>
      <ViewsRuntimeOutput Include="$(ViewsWebDir)/view-app/dist/**/*" />
      <ResolvedFileToPublish Include="@(ViewsRuntimeOutput)">
        <RelativePath>apps-views/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="config.example\**" LinkBase="config.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(DbDataKitRoot)build/DuckDb.Native.targets" />
</Project>
