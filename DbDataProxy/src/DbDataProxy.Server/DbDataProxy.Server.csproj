<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dbdataproxy</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Apache.Arrow.Flight.AspNetCore" />
    <PackageReference Include="Apache.Arrow.Flight.Sql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="DuckDB.NET.Data" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar; plan 13, C04 -->
    <DbDataKitReference Include="Serving.FlightSql" />   <!-- the Flight SQL wire module, moved out of this project (plan 19, N02) -->
    <DbDataKitReference Include="Semantic.Cli" />   <!-- the semantic noun of the command line; plan 19, J15 -->
    <DbDataKitReference Include="Serving.Semantic" />   <!-- semantic requests and semantic SQL over the data sources; plan 19, J10 -->
    <DbDataKitReference Include="Semantic.Ssas" />   <!-- Analysis Services sources of a semantic model (Windows only at run time); plan 19, J16 -->
    <DbDataKitReference Include="Connections.Abstractions" />   <!-- connection/1, the data source format; plan 13, E02 -->
    <DbDataKitReference Include="Connections.SqlServer" />
    <DbDataKitReference Include="Connections.FlightSql" />   <!-- an upstream Flight SQL server as a data source; plan 13a, P12 -->
    <DbDataKitReference Include="Connections.Postgres" />   <!-- PostgreSQL data sources; plan 13a, P12 -->
    <DbDataKitReference Include="Connections.DuckDb" />
    <DbDataKitReference Include="Config.Yaml" />
    <DbDataKitReference Include="Config" />
    <DbDataKitReference Include="Config.Hosting" />
    <DbDataKitReference Include="Secrets.Abstractions" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Secrets.Store" />
    <DbDataKitReference Include="Secrets.Cli" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <DbDataKitReference Include="Hosting.Abstractions" />
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Hosting.Children" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="State" />
    <DbDataKitReference Include="State.Engines" />   <!-- SQLite, SQL Server or PostgreSQL for it, as the operator names; plan 13a, P11 -->   <!-- the proxy's state database; plan 13, P02 -->
    <DbDataKitReference Include="Web" />   <!-- the management API: pairing, tokens, roles; plan 13, P03 -->
    <DbDataKitReference Include="Config.Git" />   <!-- the configuration folder is a git repository; every change is a commit by the person who made it -->
    <DbDataKitReference Include="Hosting.Local" />   <!-- the local channel for the command line on this machine -->
    <ProjectReference Include="..\DbDataProxy.Core\DbDataProxy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DbDataProxy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="config.example\**" LinkBase="config.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(DbDataKitRoot)build/DuckDb.Native.targets" />
</Project>
