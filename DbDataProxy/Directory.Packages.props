<Project>
  <!-- the third-party versions are in the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <DbDataKitVersion>0.1.0</DbDataKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DbDataKit.Cli" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Connections.Abstractions" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Connections" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Connections.SqlServer" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Connections.DuckDb" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Connections.Odbc" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Metadata.Abstractions" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Metadata" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Odbc.Metadata" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Dialect.Abstractions" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Dialect" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Config.Yaml" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Config" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Config.Hosting" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Config.Testing" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Secrets.Abstractions" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Secrets" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Secrets.Windows" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Secrets.Store" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Secrets.Cli" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Abstractions" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.WindowsService" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Systemd" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Certificates" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Certificates.Windows" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Children" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Hosting.Cli" Version="$(DbDataKitVersion)" />
    <PackageVersion Include="DbDataKit.Security.Acl" Version="$(DbDataKitVersion)" />
  </ItemGroup>
</Project>
