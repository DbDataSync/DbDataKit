[Unit]
Description=DbDataProxy Arrow Flight SQL proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/dbdataproxy/dbdataproxy server run
WorkingDirectory=/opt/dbdataproxy
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

# Identity
DynamicUser=yes
StateDirectory=dbdataproxy
Environment="DBPROXY_Proxy__DataDirectory=/var/lib/dbdataproxy"

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
