# The Bun every build of an app's source uses (DbDataKit.Apps.Bundling, plan 19 AP01-AP02): a published release of https://github.com/oven-sh/bun.
# Read by scripts/fetch-bun.sh (KEY=value lines, nothing else is evaluated). Each archive is checked against the SHA-256 recorded here, and so is the program inside it.
# The archive hashes were taken from the release's own SHASUMS256.txt and matched against the downloaded files. To move to a new release: set VERSION and BASE, then for
# each platform the archive's SHA-256 and the program's, and run scripts/fetch-bun.sh all.
VERSION=1.3.14
BASE=https://github.com/oven-sh/bun/releases/download/bun-v1.3.14

# rid: the .NET runtime identifier the program is installed under (.bun/<rid>/)
ARCHIVE_linux_x64=bun-linux-x64.zip
ARCHIVE_SHA256_linux_x64=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f
BIN_linux_x64=bun
BIN_SHA256_linux_x64=9fd36f87e4b90b07632b987a2e4ec81ca15a62c81bf983190cea6d715be2ad74

ARCHIVE_linux_arm64=bun-linux-aarch64.zip
ARCHIVE_SHA256_linux_arm64=a27ffb63a8310375836e0d6f668ae17fa8d8d18b88c37c821c65331973a19a3b
BIN_linux_arm64=bun
BIN_SHA256_linux_arm64=37141662ebed915a2ab89313156e455e2a1374395f5f6760d06407f49406f086

ARCHIVE_win_x64=bun-windows-x64.zip
ARCHIVE_SHA256_win_x64=0a0620930b6675d7ba440e81f4e0e00d3cfbe096c4b140d3fff02205e9e18922
BIN_win_x64=bun.exe
BIN_SHA256_win_x64=0187f68d843f825a72ada4a7eca60db896ed753759a7f8252edcd31ac1bf1b9c

ARCHIVE_osx_arm64=bun-darwin-aarch64.zip
ARCHIVE_SHA256_osx_arm64=d8b96221828ad6f97ac7ac0ab7e95872341af763001e8803e8267652c2652620
BIN_osx_arm64=bun
