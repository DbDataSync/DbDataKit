{
  // Copy the parts you need into appsettings.json. Settings can also come from environment variables
  // (DBPROXY_Proxy__Listen__Port=9000) or the command line (--Proxy:Listen:Port=9000).
  "Proxy": {
    // Secrets are references, not literals: env:NAME, file:PATH, secret:dbdata:proxy:..., dpapi:<base64> (see README, "Secrets").
    // A literal still works but logs a warning naming the key; true refuses to start with literal secrets.
    "RequireReferencedSecrets": false,

    "Listen": { "Address": "0.0.0.0", "Port": 8815 },

    // SelfSigned: a certificate is generated on first start (and renewed near expiry or when names change) in
    // DataDirectory; import the .cer written beside it into clients that need to trust it.
    // File: use your own PFX.  None: plain HTTP/2 (local testing only - credentials travel in clear text).
    "Tls": {
      "Mode": "SelfSigned",
      "Hostnames": [ "proxy.example.com" ]
      // "Mode": "File", "CertificatePath": "C:\certs\proxy.pfx", "CertificatePassword": "env:DBPROXY_PFX_PASSWORD"
    },

    // Mode: None | Grpc (gRPC compression, gzip) | Arrow (Arrow data compression: zstd or lz4 inside the Arrow stream; best ratio).
    // Clients can override per call with the "x-compression" header (none, gzip, zstd, lz4) unless disabled here.
    "Compression": { "Mode": "Arrow", "Codec": "zstd", "Level": 3, "AllowClientOverride": true },

    // JWT with a shared HMAC key: "Jwt": { "SigningKey": "file:C:\secrets\jwt.key", "Audience": "api://dbproxy", "Mappings": [ ... ] }
    "Auth": { "SessionIdleMinutes": 30, "SessionMaxHours": 12, "AllowPassThrough": true },

    // Clients choose a data source with the "x-datasource" header; they never send connection strings.
    "DataSources": {
      "erp": {
        "Provider": "sqlserver",
        "ConnectionString": "Server=SQL01;Database=Erp;User Id=proxy_reader;Password=env:ERP_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True",
        "CommandTimeoutSeconds": 300
      },
      "legacy": {
        // 32-bit ODBC drivers run in the bundled 32-bit worker process.
        "Provider": "odbc",
        "Bitness": "x86",
        "ConnectionString": "Driver={Some 32-bit Driver};Dsn=Legacy;",
        "Compression": { "Mode": "Arrow", "Codec": "lz4" }
      },
      "warehouse": {
        // Callers' own database credentials (the username/password they authenticate with) are used to connect.
        "Provider": "odbc",
        "PassThrough": true,
        "ConnectionString": "Driver={ODBC Driver 18 for SQL Server};Server=SQL02;Database=Dw;Encrypt=yes;TrustServerCertificate=yes"
      },
      "scratch": {
        "Provider": "duckdb",
        "ConnectionString": "Data Source=C:\data\scratch.duckdb",
        "AllowWrites": true
      }
    },

    // Generate hashes with: DbDataProxy hash-password
    "Users": [
      {
        "Name": "reporting",
        "PasswordHash": "PBKDF2-SHA256$210000$...$...",
        "DataSources": [ "erp", "legacy" ],
        "DefaultDataSource": "erp"
      }
    ]
  }
}
