<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109h: DbDataSync.Drivers.Oracle.csproj's own PackageReference excludes runtime assets (it
         compiles against the reference assembly but does not ship the DLL) — see that project's
         identical comment. This test project needs its own, un-excluded, direct reference so a
         standalone `dotnet test` run here has a real local copy to actually connect with. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Oracle\DbDataSync.Drivers.Oracle.csproj" />
  </ItemGroup>

</Project>
