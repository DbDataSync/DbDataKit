<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />   <!-- the runtime package scripts are bash (SyncRuntimePackageTests) -->
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109h: this test project's own scaffolding (RunExecutorIntegrationTests.cs,
         Scd2NaturalKeyIntegrationTests.cs) uses Microsoft.Data.SqlClient directly to set up a scratch
         SQL Server database, previously supplied transitively through DbDataSync.Drivers.MsSql's own
         (now ExcludeAssets="runtime") PackageReference — a real gap the phase doc's own "two driver
         test projects" framing did not anticipate, found by actually running the full suite rather than
         assumed. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- the runner's own state (progress, runs, scheduling) on PostgreSQL, when DBDATA_TEST_POSTGRES is set -->
    <PackageReference Include="Npgsql" />
    <!-- the targets of ChangeApplyReplicationTests (plan 28c, CW01): the other engines' providers, which the driver projects exclude at run time -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.TaskRunner\DbDataSync.TaskRunner.csproj" />
    <!-- the runner a drain is run by in DrainOnTheRunnerTests (plan 28c, E03): its executor and the listener tasks speak to -->
    <DbDataKitReference Include="Runner" />
    <DbDataKitReference Include="Runner.Protocol.Server" />
    <Using Include="DbDataKit.State" />
    <Using Include="DbDataKit.Monitoring" />   <!-- plan 13, U04 -->
    <Using Include="DbDataSync.State.StateDatabase" Alias="StateDatabase" />
  </ItemGroup>

  <ItemGroup>
    <!-- One scratch-database teardown for every test project that makes one; see its doc comment. -->
    <Compile Include="..\Shared\MsSqlScratch.cs" Link="Shared\MsSqlScratch.cs" />
    <Compile Include="..\Shared\TestEngines.cs" Link="Shared\TestEngines.cs" />
  </ItemGroup>

</Project>