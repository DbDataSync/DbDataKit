<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109h: both driver projects' own PackageReferences now exclude runtime assets (they
         compile against the reference assembly but no longer ship the DLL). This test project needs its
         own, un-excluded, direct references to both — not only Npgsql — because it also references the
         MsSql driver project and touches Microsoft.Data.SqlClient directly (MsSqlScratchDatabase.cs,
         CrossEngineReplicationTests.cs), the one place the phase doc's "one package per test project"
         framing undersold: a standalone `dotnet test` run here needs both real local copies. -->
    <PackageReference Include="Microsoft.Data.SqlClient" VersionOverride="7.0.2" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both drivers: the milestone this phase exists for is cross-engine replication, which cannot
         be tested from inside either driver's own project. -->
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.MsSql\DbDataSync.Drivers.MsSql.csproj" />
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Postgres\DbDataSync.Drivers.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One scratch-database teardown for every test project that makes one; see its doc comment. -->
    <Compile Include="..\Shared\MsSqlScratch.cs" Link="Shared\MsSqlScratch.cs" />
  </ItemGroup>

</Project>
