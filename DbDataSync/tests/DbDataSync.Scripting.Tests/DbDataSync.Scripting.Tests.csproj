<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109i: a real gap the original phase doc's own grep missed, because it looked for the
         literal type name in this project's own source, which never appears here. But
         SegmentingStrategyRunnerTests.cs exercises SegmentingStrategyRunner's DuckDb-kind path
         (OnlyDuckDbNeedsNoConnection_AndItGetsNone and others), which `new DuckDBConnection(...)`s
         *inside DbDataSync.Scripting* — a runtime dependency this project's tests actually hit, even
         though no .cs file here mentions DuckDB by name. Confirmed by actually running the suite after
         DbDataSync.Scripting.csproj's own ExcludeAssets landed, not by trusting the grep alone. -->
    <PackageReference Include="DuckDB.NET.Data" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Scripting\DbDataSync.Scripting.csproj" />
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <!-- Test-only: proving phase 27's ILifecycleHook contract against both real dialects (the
         cross-engine schema-evolution case it exists for), without pulling either driver into
         DbDataSync.Scripting itself. -->
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.MsSql\DbDataSync.Drivers.MsSql.csproj" />
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Postgres\DbDataSync.Drivers.Postgres.csproj" />
  </ItemGroup>

  <Import Project="$(DbDataKitRoot)build/DuckDb.Native.targets" />
</Project>
