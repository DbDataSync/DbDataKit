<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="JsonSchema.Net" />
    <!-- Phase 109h: InviteCommandTests.cs uses Microsoft.Data.SqlClient directly (its own scratch-database
         scaffolding, ahead of the LibraryRegistry-backed install its own comment already documents) —
         previously supplied transitively through DbDataSync.Drivers.MsSql's own PackageReference, which
         now excludes runtime assets. A real gap beyond the phase doc's own "two driver test projects"
         framing, found by running the full suite. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Cli\DbDataSync.Cli.csproj" />
    <!-- a real dbdatarunner server, in process, that a replication set is published to (plan 28c, E08: PackagePublishOnRealRunnerTests) -->
    <ProjectReference Include="..\..\..\DbDataRunner\src\DbDataRunner.Server\DbDataRunner.Server.csproj" />
    <Using Include="DbDataKit.State" />
    <Using Include="DbDataKit.Web.Auth" />
    <Using Include="DbDataKit.Monitoring" />   <!-- plan 13, U04 -->
    <Using Include="DbDataSync.State.StateDatabase" Alias="StateDatabase" />
  </ItemGroup>

  <!-- the server's own build output, where the build put the task host beside the program (as DbDataRunner.Tests and Build's conformance tests do) -->
  <Target Name="WriteServerOutput" AfterTargets="Build">
    <MSBuild Projects="..\..\..\DbDataRunner\src\DbDataRunner.Server\DbDataRunner.Server.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_ServerDll" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)server-output.txt" Lines="$([System.IO.Path]::GetDirectoryName('$(_ServerDll)'))" Overwrite="true" />
  </Target>

  <ItemGroup>
    <!-- One scratch-database teardown for every test project that makes one; see its doc comment. -->
    <Compile Include="..\Shared\MsSqlScratch.cs" Link="Shared\MsSqlScratch.cs" />
    <Compile Include="..\Shared\TestEngines.cs" Link="Shared\TestEngines.cs" />
  </ItemGroup>

</Project>
