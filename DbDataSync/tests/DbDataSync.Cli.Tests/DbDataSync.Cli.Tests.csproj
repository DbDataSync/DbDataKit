<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109h: InviteCommandTests.cs uses Microsoft.Data.SqlClient directly (its own scratch-database
         scaffolding, ahead of the LibraryRegistry-backed install its own comment already documents) —
         previously supplied transitively through DbDataSync.Drivers.MsSql's own PackageReference, which
         now excludes runtime assets. A real gap beyond the phase doc's own "two driver test projects"
         framing, found by running the full suite. -->
    <PackageReference Include="Microsoft.Data.SqlClient" VersionOverride="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Cli\DbDataSync.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One scratch-database teardown for every test project that makes one; see its doc comment. -->
    <Compile Include="..\Shared\MsSqlScratch.cs" Link="Shared\MsSqlScratch.cs" />
  </ItemGroup>

</Project>
