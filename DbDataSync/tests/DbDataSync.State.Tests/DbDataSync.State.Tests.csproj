<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Phase 109g: DbDataSync.State itself no longer references these two (it resolves them through
         LibraryRegistry at runtime instead — see MsSqlStateDialect/PostgresStateDialect), but
         StateEngineFixture still needs SqlConnectionStringBuilder/NpgsqlConnectionStringBuilder and
         NpgsqlConnection.ClearAllPools() at compile time for its own scratch-database scaffolding,
         which is a test concern independent of how the product resolves a connection at runtime. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.State\DbDataSync.State.csproj" />
    <!-- the shared state types come with the project reference; StateDatabase is Sync's own (plan 13, U04) -->
    <Using Include="DbDataKit.State" />
    <Using Include="DbDataSync.State.StateDatabase" Alias="StateDatabase" />
    <!-- LibraryRegistry/LibraryInstaller/KnownLibraries — LibraryInstallFixture uses these to restore
         microsoft-data-sqlclient/npgsql for real, once per test class, the same way
         DbDataSync.Api.Tests' DescriptorDriverApiFactory does for MySqlConnector. -->
    <ProjectReference Include="..\..\src\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One scratch-database teardown for every test project that makes one; see its doc comment. -->
    <Compile Include="..\Shared\MsSqlScratch.cs" Link="Shared\MsSqlScratch.cs" />
  </ItemGroup>

</Project>