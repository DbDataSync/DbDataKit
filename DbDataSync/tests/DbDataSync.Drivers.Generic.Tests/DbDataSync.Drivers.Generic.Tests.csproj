<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- GenericDriverTests proves GenericDriver against a real, non-trivial engine (Postgres) without
         referencing DbDataSync.Drivers.Postgres itself — the point is that nothing but the ADO.NET
         provider and DbDataSync.Core.Sql's PostgresDialect is needed to stand one up. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the test engines are (DBDATASYNC_TEST_* variables); see its doc comment. -->
    <Compile Include="..\Shared\TestEngines.cs" Link="Shared\TestEngines.cs" />
  </ItemGroup>

</Project>
