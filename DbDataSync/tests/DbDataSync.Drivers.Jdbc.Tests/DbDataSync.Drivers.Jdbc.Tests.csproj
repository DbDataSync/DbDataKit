<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The "known-good" side of every parity test in this project — see phase 109h's identical
         un-excluded reference in DbDataSync.Drivers.Postgres.Tests.csproj. -->
    <PackageReference Include="Npgsql" />
    <!-- DbDataSync.Drivers.Jdbc now excludes IKVM's runtime/build/native assets (resolved instead from
         libraries/ikvm/lib/ via LibraryRegistry in a real deployment — see that project's own csproj
         comment) — the same reason DbDataSync.Drivers.Postgres.Tests keeps its own un-excluded Npgsql
         reference. A standalone `dotnet test` here needs the real IKVM assets locally too, with nothing
         installed under libraries/. -->
    <PackageReference Include="IKVM" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Jdbc\DbDataSync.Drivers.Jdbc.csproj" />
    <!-- The "known-good" side of every parity test: PostgresDriver's own published readers, not a
         hand-wired PostgresCatalog/PostgresValueBinding pair (both internal to that project). -->
    <ProjectReference Include="..\..\src\DbDataSync.Drivers.Postgres\DbDataSync.Drivers.Postgres.csproj" />
  </ItemGroup>

  <!-- Phase 165V's own "Open question 2": every other engine's client library in this repo comes
       through NuGet (ExcludeAssets="runtime") or LibraryRegistry, never a committed binary — a .jar is
       neither. Downloaded here at build time (Maven Central, confirmed reachable) into an ignored obj/
       path, rather than committed, per that same convention — see the phase doc's own reasoning. -->
  <PropertyGroup>
    <JdbcTestJarVersion>42.7.13</JdbcTestJarVersion>
    <JdbcTestJarPath>$(BaseIntermediateOutputPath)jdbc-jars\postgresql-$(JdbcTestJarVersion).jar</JdbcTestJarPath>
  </PropertyGroup>

  <Target Name="DownloadJdbcTestJar" BeforeTargets="BeforeBuild" Condition="!Exists('$(JdbcTestJarPath)')">
    <MakeDir Directories="$(BaseIntermediateOutputPath)jdbc-jars" />
    <DownloadFile
      SourceUrl="https://repo1.maven.org/maven2/org/postgresql/postgresql/$(JdbcTestJarVersion)/postgresql-$(JdbcTestJarVersion).jar"
      DestinationFolder="$(BaseIntermediateOutputPath)jdbc-jars" />
  </Target>

  <ItemGroup>
    <None Include="$(JdbcTestJarPath)" CopyToOutputDirectory="PreserveNewest" Link="postgresql.jar" Visible="false" />
  </ItemGroup>

  <!-- Phase 169V's own "how to verify" fixture: a second, genuinely distinct jar with nothing pgJDBC
       needs, proving JdbcProviderFactory.FromJarPaths' combined classpath actually spans more than one
       file — not just tolerates a one-element list. A true two-interdependent-classes fixture (the doc's
       first choice) needs javac/jar, unavailable in this environment (confirmed: `which javac` — not
       found) — this decoy jar is the fallback the doc named, real rather than hand-waved. -->
  <PropertyGroup>
    <JdbcDecoyJarPath>$(BaseIntermediateOutputPath)jdbc-jars\commons-logging-1.2.jar</JdbcDecoyJarPath>
  </PropertyGroup>

  <Target Name="DownloadJdbcDecoyJar" BeforeTargets="BeforeBuild" Condition="!Exists('$(JdbcDecoyJarPath)')">
    <MakeDir Directories="$(BaseIntermediateOutputPath)jdbc-jars" />
    <DownloadFile
      SourceUrl="https://repo1.maven.org/maven2/commons-logging/commons-logging/1.2/commons-logging-1.2.jar"
      DestinationFolder="$(BaseIntermediateOutputPath)jdbc-jars" />
  </Target>

  <ItemGroup>
    <None Include="$(JdbcDecoyJarPath)" CopyToOutputDirectory="PreserveNewest" Link="decoy.jar" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the test engines are (DBDATASYNC_TEST_* variables); see its doc comment. -->
    <Compile Include="..\Shared\TestEngines.cs" Link="Shared\TestEngines.cs" />
  </ItemGroup>

</Project>
