<Project>

  <!-- Applied to every project, so `dotnet test` picks it up with no argument to remember. -->
  <PropertyGroup>
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MSBuildThisFileDirectory)dbdatasync.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Monorepo layout: DbDataSync/ and DbDataKit/ (the shared libraries) are sibling folders at the repository root. -->
    <DbDataKitRoot Condition="'$(DbDataKitRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'DbDataKit'))</DbDataKitRoot>
    <DbDataKitRoot>$([MSBuild]::EnsureTrailingSlash('$(DbDataKitRoot)'))</DbDataKitRoot>
    <UseLocalDbDataKit Condition="'$(UseLocalDbDataKit)' == '' and Exists('$(DbDataKitRoot)src')">true</UseLocalDbDataKit>
    <DbDataKitVersion Condition="'$(DbDataKitVersion)' == ''">0.1.0</DbDataKitVersion>
  </PropertyGroup>

</Project>
