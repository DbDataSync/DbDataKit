<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <!-- For ResultSetSchema only. This driver shares none of Generic's readers or writers — a
         query-first source has no statement for them to build — but "read a result set into a
         ChangeRow" is the same problem every reader in the repo already solved once. -->
    <ProjectReference Include="..\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compile reference only: ExcludeAssets="runtime;native" keeps the managed DLL out of this project's and DbDataSync.Api/.Cli's
      output (phase 109i, the treatment Microsoft.Data.SqlClient and Npgsql get). At first touch the assembly loads through
      LibraryRegistry's AssemblyLoadContext.Default.Resolving hook, once ServeCommand's unconditional install has put it under
      <repo>/libraries/duckdb/lib/ — see ServeCommand.EnsureDuckDbInstalledAsync.

      Plan 13 (K05): the package is DuckDB.NET.Data, managed bindings only, not `.Full` with its bundled 1.x engine. The engine
      (DuckDB 2.0.0) comes from the repository's duckdb.pin: DbDataSync.Libraries.DuckDbEngine downloads it next to the installed
      assemblies, checking the archive's and the library's SHA-256 against the pin (DBDATASYNC_DUCKDB_ENGINE_SOURCE names a directory
      to take the archive from on a machine without internet access), and the Docker image carries it in its library cache.
    -->
    <PackageReference Include="DuckDB.NET.Data" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
