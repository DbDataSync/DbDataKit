<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <DbDataKitReference Include="Sync.Core" />
    <DbDataKitReference Include="Sync.Drivers.Abstractions" />
    <DbDataKitReference Include="Sync.Drivers.Generic" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Transfer.Postgres" />   <!-- binary COPY staging; plan 13, A15 -->
    <DbDataKitReference Include="Connections.Postgres" />   <!-- the Npgsql composer; plan 13, A08 -->
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime" (phase 109h) — see DbDataSync.Drivers.MsSql.csproj's identical comment
         for why: compiles unchanged, ships nothing, resolved at first touch through LibraryRegistry's
         AssemblyLoadContext.Resolving handler from <repo>/libraries/npgsql/lib/. -->
    <PackageReference Include="Npgsql" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Drivers.Postgres.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
