<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Connections.Postgres" />   <!-- the Npgsql composer; plan 13, A08 -->
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime" (phase 109h) — see DbDataSync.Drivers.MsSql.csproj's identical comment
         for why: compiles unchanged, ships nothing, resolved at first touch through LibraryRegistry's
         AssemblyLoadContext.Resolving handler from <repo>/libraries/npgsql/lib/. -->
    <PackageReference Include="Npgsql" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Drivers.Postgres.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
