<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The command surface, not the web host: asking this tool for help should print text rather than starting Kestrel.
         Not packed: there is no dotnet tool package (owner decision 2026-11-08). Sync ships as zips (dist/README.md), built by
         .github/workflows/dbdatasync-release.yml with `dotnet publish`; no installer, service or image since plan 33 SC23. -->
    <!--
      Every build not explicitly versioned gets a fresh alpha, dated and timed at evaluation, so a local build never reports a
      release version. -p:Version=X on the command line still wins outright: MSBuild treats a command-line property as global, and a
      global property cannot be overwritten by a plain assignment in the project file, conditioned or not — which is exactly what
      lets .github/workflows/dbdatasync-release.yml pass -p:Version=YYYY.M.D.HHmm and get a real release version with no alpha label
      and no change needed here.

      The seconds component keeps two builds inside one minute from reporting the same version. Unpadded ("s", not "ss") on purpose:
      a prerelease identifier is SemVer2-numeric and MUST NOT carry a leading zero, unlike the four-part core above it —
      "-alpha.05" is a hard NETSDK1018 error where "2026.09" is merely normalised away, and this is the one part of the string
      actually built from a two-digit clock field often small enough to have one.
    -->
    <Version>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm'-alpha.'s"))</Version>
    <Description>Cross-database replication: a command line on a configuration repository, and the engine a Runner runs (the Sync server was deleted, plan 33 SC23).</Description>
    <Authors>Dan Shryock</Authors>

    <!--
      Framework-dependent and RID-agnostic. LibGit2Sharp, SQLite and DuckDB.NET all ship their native
      assets under runtimes/(rid)/ and resolve at run time, so one build serves every platform.
    -->
    <RollForward>latestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared SqlClient, Npgsql, MySqlConnector and ODP.NET composers (plan 13, A08, A09) bring their packages with runtime assets. A direct reference that
         excludes them wins over the transitive one, so the drivers still come from <repo>/libraries/ at first touch, as the driver
         projects' own comments describe. -->
    <PackageReference Include="Microsoft.Data.SqlClient" ExcludeAssets="runtime" />
    <PackageReference Include="Npgsql" ExcludeAssets="runtime" />
    <PackageReference Include="MySqlConnector" ExcludeAssets="runtime" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Drivers.Descriptor\DbDataSync.Drivers.Descriptor.csproj" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
    <ProjectReference Include="..\DbDataSync.State\DbDataSync.State.csproj" />
    <ProjectReference Include="..\DbDataSync.Scripting\DbDataSync.Scripting.csproj" />   <!-- the script test (plan 33 SC23d1) -->
    <DbDataKitReference Include="Sync.Provisioning" />   <!-- provisioning plan -->
    <!-- the replication set's package (package publish) is the engine's own; its build output is the dbdatasync-runtime package of a Runner -->
    <ProjectReference Include="..\DbDataSync.TaskRunner\DbDataSync.TaskRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Catalog.Cache" />   <!-- the catalog cache of a project draft: provisioning plan reads it offline; plan 33, SC22j -->
    <DbDataKitReference Include="State.Engines" />   <!-- the suite's one reader of the data folder and the old variable names (SuiteEnvironment); plan 33 SC31 -->
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar and the JSON document; plan 13, C07 -->
    <DbDataKitReference Include="Lineage.Cli" />   <!-- the lineage noun over the replications of the repository; plan 18, G07b -->
    <DbDataKitReference Include="Runner.Client" />   <!-- the shared publishing client: package publish; plan 28c, E08 -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Cli.Tests" />
  </ItemGroup>

</Project>
