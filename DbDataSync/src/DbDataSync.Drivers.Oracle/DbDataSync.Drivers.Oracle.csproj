<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <DbDataKitReference Include="Sync.Core" />
    <DbDataKitReference Include="Sync.Drivers.Abstractions" />
    <DbDataKitReference Include="Sync.Drivers.Generic" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Connections.Oracle" />   <!-- the ODP.NET composer; plan 13, A09 -->
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime" (phase 109h) — see DbDataSync.Drivers.Postgres.csproj's identical comment
         for why: compiles unchanged, ships nothing, resolved at first touch through LibraryRegistry's
         AssemblyLoadContext.Resolving handler from <repo>/libraries/oracle-managed-data-access/lib/. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Drivers.Oracle.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
