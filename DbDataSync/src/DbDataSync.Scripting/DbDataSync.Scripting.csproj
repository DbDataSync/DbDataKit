<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
    <ProjectReference Include="..\DbDataSync.Scripting.Abstractions\DbDataSync.Scripting.Abstractions.csproj" />
    <!-- plan 33 SC23d1: the script test, schema browsing and the opener of a configured connection moved here from DbDataSync.Api, so the
         command line (script test) and any program that composes them reach them without the server. The opener implements Provisioning's
         IConnectionFactory and IColumnCatalog, and seeds a built-in driver's library through State's BuiltInDriverLibraries. No driver project:
         a program brings the drivers it registers. -->
    <ProjectReference Include="..\DbDataSync.Provisioning\DbDataSync.Provisioning.csproj" />
    <ProjectReference Include="..\DbDataSync.State\DbDataSync.State.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 109i: ExcludeAssets="runtime"; phase 146 added ";native" — see
         DbDataSync.Drivers.DuckDb.csproj's comment for the mechanism, identical here. No .cs file in
         this project changed either phase; SegmentingStrategyRunner.cs still `new
         DuckDBConnection(...)` directly for a DuckDb-kind strategy. -->
    <PackageReference Include="DuckDB.NET.Data" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <DbDataKitReference Include="Scripting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Scripting.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
