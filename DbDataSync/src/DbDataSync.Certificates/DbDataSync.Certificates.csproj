<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Deliberately net10.0, not net10.0-windows. The Linux container image (phase 51) publishes
      DbDataSync.Cli, which references DbDataSync.Api, which will reference this project for the
      certificate-expiry hosted service — a net10.0-windows TFM here would make that reference an
      SDK error on a project that has to keep building on Linux. Every genuinely Windows-only member
      is marked [SupportedOSPlatform("windows")] instead (phase 51's ServiceCommand precedent), and
      every caller gates on OperatingSystem.IsWindows() before it is reached — see the phase 82 doc's
      "why net10.0, not net10.0-windows" reasoning, restated here at the point it actually bites.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared server-certificate code (self-signed generation, expiry, plain-HTTP guard); see docs/plans/03-windows-service-hosting.md 3.4. -->
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Hosting.Certificates.Windows" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Certificates.Tests" />
  </ItemGroup>

</Project>
