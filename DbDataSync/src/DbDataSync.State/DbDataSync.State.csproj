<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <!-- Phase 109g: MsSql/PostgresStateDialect resolve their DbConnection through LibraryRegistry
         instead of a direct Microsoft.Data.SqlClient/Npgsql PackageReference — see those two classes'
         own doc comments. -->
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="State" />   <!-- the engine, dialects and the identity and notification stores; plan 13, U04 -->
    <Using Include="DbDataKit.State" />
    <Using Include="DbDataKit.Monitoring" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite is the default and the only engine an unconfigured deployment ever opens, so it stays a
         hard reference (phase 63); it is also offline and serverless, which is why phase 109g left it
         alone. Microsoft.Data.SqlClient and Npgsql are no longer referenced here at all — an operator
         on StateEngine MsSql/Postgres runs `dbdatasync library install
         microsoft-data-sqlclient`/`npgsql` once instead (see StateDatabase.FromOptions and this
         project's retrospective phase doc). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
