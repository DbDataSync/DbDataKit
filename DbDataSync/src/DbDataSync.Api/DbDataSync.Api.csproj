<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SkipJdbc (root Directory.Build.props): ConnectionDiagnostics names JdbcSqlException, the one compile-time use of the Jdbc project. -->
    <DefineConstants Condition="'$(SkipJdbc)' == 'true'">$(DefineConstants);SKIP_JDBC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared SqlClient, Npgsql, MySqlConnector and ODP.NET composers (plan 13, A08, A09) bring their packages with runtime assets. A direct reference that
         excludes them wins over the transitive one, so the drivers still come from <repo>/libraries/ at first touch, as the driver
         projects' own comments describe. -->
    <PackageReference Include="Microsoft.Data.SqlClient" ExcludeAssets="runtime" />
    <PackageReference Include="Npgsql" ExcludeAssets="runtime" />
    <PackageReference Include="MySqlConnector" ExcludeAssets="runtime" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="State.Engines" />   <!-- the suite's one reader of the data folder and state variables (SuiteEnvironment); plan 33 SC31 -->
    <DbDataKitReference Include="Connections.Descriptor" />   <!-- the engine registry: which built-in drivers are the suite's engines and their Sync roles; plan 14a, SL04 -->
    <DbDataKitReference Include="Web" />   <!-- the web host's shared parts: the console's signed token, the policies, the management API (plan 13a, X06: no sign-in of Sync's own) -->
    <DbDataKitReference Include="Quality.Runner" />   <!-- the check evaluator and its run service: the checks stored with a replication are evaluated after its runs; plan 23a, FQ10 -->
    <DbDataKitReference Include="Scheduling" />   <!-- the schedule evaluator (Cronos comes with it); plan 13, M01 -->
    <DbDataKitReference Include="Runner.Client" />   <!-- the paired runner's client: the owner of a replication, run now, pause and resume on the runner; plan 28c, E12 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Lifetime and logging for a process the Windows SCM starts. Cross-platform to reference; the
         helper it provides answers false everywhere else, so nothing is conditional here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Phase 111's systemd analog of the package above — sd_notify(READY=1)/journal logging for a
         process systemd starts. Same cross-platform-to-reference reasoning: its own helper answers
         false everywhere but a real systemd unit. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <!-- So AdminCertificateServiceWindowsTests can drive AdminCertificateService.EvaluateKeyAccess's
         internal, testable overload directly (the account passed in, not resolved via a real installed
         Windows service) — the same precedent DbDataSync.Certificates.csproj already sets for its own
         internal-but-tested members. -->
    <InternalsVisibleTo Include="DbDataSync.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Certificates\DbDataSync.Certificates.csproj" />
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Scripting\DbDataSync.Scripting.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.MsSql\DbDataSync.Drivers.MsSql.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.ArrowFlightSql\DbDataSync.Drivers.ArrowFlightSql.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.DuckDb\DbDataSync.Drivers.DuckDb.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Descriptor\DbDataSync.Drivers.Descriptor.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Postgres\DbDataSync.Drivers.Postgres.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.MySql\DbDataSync.Drivers.MySql.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Oracle\DbDataSync.Drivers.Oracle.csproj" />
    <!-- Phase 168V: not used directly here — needed so a driver.yaml naming JdbcGenericDriver as its
         base can be resolved via Type.GetType (DriverDescriptorReader.BuildDriver, in
         DbDataSync.Drivers.Descriptor). JdbcGenericDriver is still not in BuiltInDrivers/registered by
         default; this only makes it reachable if named. -->
    <ProjectReference Condition="'$(SkipJdbc)' != 'true'" Include="..\DbDataSync.Drivers.Jdbc\DbDataSync.Drivers.Jdbc.csproj" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
    <ProjectReference Include="..\DbDataSync.State\DbDataSync.State.csproj" />
    <ProjectReference Include="..\DbDataSync.Tracking\DbDataSync.Tracking.csproj" />   <!-- the follower of the units a target holds, and the divergence record (plan 28c E17) -->
    <ProjectReference Include="..\DbDataSync.Planning\DbDataSync.Planning.csproj" />   <!-- the planner SchedulerService calls (plan 28c E11); its namespace is a global using below, so the API's own code keeps naming the types it always did -->
    <Using Include="DbDataSync.Planning" />
    <!-- the shared state types come with the project reference; StateDatabase is Sync's own (plan 13, U04) -->
    <Using Include="DbDataKit.State" />
    <Using Include="DbDataKit.Web.Auth" />
    <Using Include="DbDataKit.Monitoring" />
    <Using Include="DbDataSync.State.StateDatabase" Alias="StateDatabase" />
    <ProjectReference Include="..\DbDataSync.Updates\DbDataSync.Updates.csproj" />
    <ProjectReference Include="..\DbDataSync.Verification\DbDataSync.Verification.csproj" />
  </ItemGroup>

</Project>
