<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Reading a driver.yaml moved to the shared library DbDataKit.Sync.Drivers.Descriptor with its namespace; this assembly forwards to it
       (TypeForwards.cs) and keeps what loads a library (DriverDescriptorReader.BuildDriver, DriverLoader) or compiles a driver.csx (DriverScriptHost). -->
  <ItemGroup>
    <DbDataKitReference Include="Sync.Drivers.Descriptor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
  </ItemGroup>

</Project>
