<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Reading a driver.yaml is the shared library DbDataKit.Sync.Drivers.Descriptor; this assembly holds what loads a library
       (DriverDescriptorReader.BuildDriver, DriverLoader) or compiles a driver.csx (DriverScriptHost). -->
  <ItemGroup>
    <DbDataKitReference Include="Sync.Drivers.Descriptor" />
  </ItemGroup>

  <ItemGroup>
    <DbDataKitReference Include="Sync.Core" />
    <DbDataKitReference Include="Sync.Drivers.Abstractions" />
    <DbDataKitReference Include="Sync.Drivers.Generic" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
  </ItemGroup>

</Project>
