<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbDataKit.Connections.Odbc</RootNamespace>
    <PackageId>DbDataKit.Connections.Odbc</PackageId>
    <Description>ODBC provider over System.Data.Odbc: brace-quoted composer with the Plan 04 connection policy, positional parameter adapter and best-effort SQL_ATTR_ACCESS_MODE.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="System.Data.Odbc" />
    <ProjectReference Include="..\DbDataKit.Connections\DbDataKit.Connections.csproj" />
  </ItemGroup>
</Project>
