<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbData.Connections.Libraries</RootNamespace>
    <PackageId>DbData.Connections.Libraries</PackageId>
    <Description>Hardened planning and validation layer for installing provider libraries from NuGet: package id and version grammar, restricted sources, XElement-built project, prefix-checked paths. The restore itself runs behind an interface.</Description>
    <NoWarn>$(NoWarn);CS1573;CS1572</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
