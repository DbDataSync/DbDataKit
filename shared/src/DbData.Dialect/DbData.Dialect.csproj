<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DbData.Dialect</RootNamespace>
    <NoWarn>$(NoWarn);CS1573;CS1572</NoWarn>
    <Description>Data-driven SQL dialects, shared SQL lexer, statement classifier and read-only policy.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DbData.Dialect.Abstractions\DbData.Dialect.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="dialects\*.yaml" LogicalName="DbData.Dialect.dialects.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="DbData.Dialect.Tests" />
  </ItemGroup>
</Project>
