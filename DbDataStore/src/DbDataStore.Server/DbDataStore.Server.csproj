<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>dbdatastore</AssemblyName>
    <Description>DbDataStore: master data models, kept in your own databases, with validated writes, history and audit (plans 15 and 19, lane Z).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar -->
    <DbDataKitReference Include="Hosting.Abstractions" />   <!-- the shared host: service and systemd modes, drain, /health and /version -->
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="State.Api" />   <!-- GET /api/v1/state and the maintenance mode; plan 29b, C05 -->
    <DbDataKitReference Include="State.Cli" />   <!-- state show, test and grants; plan 29b, C01 -->
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="DataModel" />   <!-- model/1: the models the server holds -->
    <DbDataKitReference Include="Store" />   <!-- validated, audited row writes -->
    <DbDataKitReference Include="Connections" />   <!-- the connection a model's tables live on -->
    <DbDataKitReference Include="Connections.SqlServer" />
    <DbDataKitReference Include="Connections.Postgres" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Store" />   <!-- this server's own key, as a client of the serving groups it publishes to (plan 20 O10) -->
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Web" />   <!-- pairing, key rotation, the version header and the token check -->
  </ItemGroup>
</Project>
