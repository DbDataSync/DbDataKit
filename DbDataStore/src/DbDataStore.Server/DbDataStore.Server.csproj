<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbdatastore</AssemblyName>
    <Description>DbDataStore: the runtime of a Store model's package on a Runner (deploy and contract of the model's tables) and a command line on a folder of models. The Store server was deleted in plan 33 SC23.</Description>
  </PropertyGroup>
  <ItemGroup>
    <DbDataKitReference Include="Cli" />   <!-- RemovedCommands: the server's commands answer with where their feature went -->
    <DbDataKitReference Include="DataModel.Runner" />   <!-- the deploy and contract tasks, run by this program as the runtime dbdatastore-runtime (dbdatastore with the runner flag); plan 33 SC24 -->
    <DbDataKitReference Include="Connections" />   <!-- the connection a model's tables live on -->
    <DbDataKitReference Include="Connections.SqlServer" />
    <DbDataKitReference Include="Connections.Postgres" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Store" />   <!-- the folder's own key, as a client of the Gateways it publishes to (plan 20 O10) -->
    <DbDataKitReference Include="DataModel" />   <!-- model/1: the models of the folder -->
    <DbDataKitReference Include="Store" />
    <DbDataKitReference Include="State.Engines" />   <!-- SuiteEnvironment: the suite's folder variables -->
    <DbDataKitReference Include="Secrets.Windows" />   <!-- the folder's key store protected with DPAPI on Windows -->
    <DbDataKitReference Include="Web" />   <!-- pairing with a Gateway as a publishing client -->
  </ItemGroup>
</Project>
