<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="Hosting/Golden/*" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <DbDataKitReference Include="Config.Testing" />
    <DbDataKitReference Include="Serving.Conformance" />
    <DbDataKitReference Include="Authoring.Server" />   <!-- the Workspace server's publish (WorkspaceGatewayPublish) run against a real Gateway: plan 33 SW01 -->
    <DbDataKitReference Include="Serving.Notify" />   <!-- the producer side of data.changed, run against a real Gateway; plan 24a UC13 -->
    <None Include="Config\Golden\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- the sample semantic model and its data, as the semantic engine's own conformance suite runs on them -->
    <None Include="..\..\..\Shared\tests\DbDataKit.Semantic.Tests\conformance\catalog\**;..\..\..\Shared\tests\DbDataKit.Semantic.Tests\conformance\data\**" Link="semantic\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="PdfPig" />
    <ProjectReference Include="..\..\src\DbDataGateway.Server\DbDataGateway.Server.csproj" />
    <ProjectReference Include="..\..\src\DbDataGateway.Worker\DbDataGateway.Worker.csproj" />
  </ItemGroup>
</Project>
