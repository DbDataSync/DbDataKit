<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>dbdatarunner</AssemblyName>
    <Description>DbDataRunner: schedules and runs the tasks of published packages, each in a process of its own, with retries, limits, run history and progress (plan 28).</Description>
      <!-- The reference only orders the build (ReferenceOutputAssembly=false) and the task host is always published framework-dependent below. Under PublishSingleFile=true this program is self-contained
         while the task host, reached with other global properties, may not be (NETSDK1150/NETSDK1151 depending on the order MSBuild evaluates them; seen on Windows CI), so the SDK's check is off. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <DbDataKitReference Include="Cli" />   <!-- the shared noun-verb grammar -->
    <DbDataKitReference Include="Config.Yaml" />   <!-- package/1 manifests -->
    <DbDataKitReference Include="Hosting.Abstractions" />   <!-- the shared host: service and systemd modes, drain, /health and /version -->
    <DbDataKitReference Include="Hosting" />
    <DbDataKitReference Include="Hosting.Cli" />
    <DbDataKitReference Include="Hosting.Startup" />   <!-- the startup sequence of server run and its startup-failure file -->
    <DbDataKitReference Include="State.Cli" />   <!-- state show, test and grants; plan 29b, C01 -->
    <DbDataKitReference Include="State.Api" />   <!-- GET /api/v1/state and the maintenance mode; plan 29b, C05 -->
    <DbDataKitReference Include="State.Engines" />   <!-- SQLite, SQL Server or PostgreSQL for the state -->
    <DbDataKitReference Include="Hosting.WindowsService" />
    <DbDataKitReference Include="Hosting.Systemd" />
    <DbDataKitReference Include="Hosting.Certificates" />
    <DbDataKitReference Include="Security.Acl" />
    <DbDataKitReference Include="Monitoring" />
    <DbDataKitReference Include="Lineage.Cli" />   <!-- the lineage noun: deployment lineage (E24) -->
    <DbDataKitReference Include="Lineage" />
    <DbDataKitReference Include="Serving.Notify" />   <!-- data.changed to the serving groups this server is paired with, after a task wrote datasets; plan 24a UC13 -->
    <DbDataKitReference Include="Scheduling" />
    <DbDataKitReference Include="State" />
    <DbDataKitReference Include="Secrets.Abstractions" />
    <DbDataKitReference Include="Secrets" />
    <DbDataKitReference Include="Secrets.Store" />   <!-- the key a publishing client signs its tokens with -->
    <DbDataKitReference Include="Secrets.Windows" />
    <DbDataKitReference Include="Runner.Abstractions" />   <!-- package/1 manifests -->
    <DbDataKitReference Include="Runner.Packaging" />   <!-- package build and package test: a csx integration is built with Roslyn and the NuGet client, no SDK (plan 27a IX20) -->
    <DbDataKitReference Include="Runner.Api" />   <!-- the management API and the publishing service layer, shared with the console's embedded runner (R20) -->
    <DbDataKitReference Include="Runner" />   <!-- the engine: artifact cache, executor, scheduler loop -->
    <DbDataKitReference Include="Runner.Limits" />   <!-- what this machine can enforce, reported as capabilities -->
    <DbDataKitReference Include="Runner.Protocol.Server" />   <!-- the socket the task processes talk to -->
    <DbDataKitReference Include="Connections" />   <!-- UI08: the slot binding test opens the connection with the engine's provider -->
    <DbDataKitReference Include="Connections.SqlServer" />
    <DbDataKitReference Include="Connections.Postgres" />
    <DbDataKitReference Include="Connections.MySql" />   <!-- plan 33 SC22h: the binding test tries every Sync engine (MySQL and MariaDB, Oracle) -->
    <DbDataKitReference Include="Connections.Oracle" />
    <DbDataKitReference Include="Web" />   <!-- pairing, key rotation, the version header and the token check -->
    <DbDataKitReference Include="Upgrade" />   <!-- the server upgrades itself when the console says so; plan 24a UC09 -->
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDbDataKit)' == 'true'">
    <!-- Private=false: its apphost, deps.json and runtimeconfig.json are not copied to this program's output root. Built for its executable only; published, with its own dependencies, to taskhost/ beside this program (see the targets below) -->
    <ProjectReference Include="$(DbDataKitRoot)src\DbDataKit.Runner.TaskHost\DbDataKit.Runner.TaskHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The built-in package dbdatakit-metadata: built for its files only, published with its own dependencies to builtin/dbdatakit-metadata/ beside this program (see the targets below); the task host loads it like any package -->
    <ProjectReference Include="$(DbDataKitRoot)src\DbDataKit.Runner.Metadata\DbDataKit.Runner.Metadata.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    The task host is the process a runner starts for a .NET package (plan 28a R06). It has its own dependency set and its own runtime configuration (plain .NET, not the ASP.NET
    shared framework this program runs on), so it is published into taskhost/ beside the program on every build, and into the publish output with it.
  -->
  <Target Name="CopyTaskHost" AfterTargets="Build" Condition="'$(UseLocalDbDataKit)' == 'true'">
    <PropertyGroup>
      <!-- absolute: OutDir is relative to this project ("bin/Debug/net10.0/") and the nested publish resolves a relative PublishDir against the task host's own folder -->
      <_TaskHostDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'taskhost'))</_TaskHostDir>
    </PropertyGroup>
    <MSBuild Projects="$(DbDataKitRoot)src\DbDataKit.Runner.TaskHost\DbDataKit.Runner.TaskHost.csproj" Targets="Publish"
             Properties="NoBuild=true;PublishDir=$(_TaskHostDir);SelfContained=false" />
  </Target>
  <!-- AFTER the list is computed: added before it, the SDK's file-conflict resolution saw two Microsoft.Data.Sqlite.dll (this program's and the task host's) and dropped this program's, so a published runner failed at start with FileNotFoundException (seen in the Windows service e2e; the console had the same bug) -->
  <Target Name="TaskHostIntoPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="CopyTaskHost" Condition="'$(UseLocalDbDataKit)' == 'true'">
    <ItemGroup>
      <_TaskHostFile Include="$(_TaskHostDir)**\*" />
      <ResolvedFileToPublish Include="@(_TaskHostFile)" RelativePath="taskhost\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    The built-in packages (docs/authoring-metadata.md, "The built-in package dbdatakit-metadata"): the runner installs them in a channel from builtin/<name>/ beside the program when they are first needed there, so they are published
    there on every build, and into the publish output with the program.
  -->
  <Target Name="CopyBuiltInPackages" AfterTargets="Build" Condition="'$(UseLocalDbDataKit)' == 'true'">
    <PropertyGroup>
      <_MetadataPackageDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'builtin', 'dbdatakit-metadata'))</_MetadataPackageDir>
    </PropertyGroup>
    <!-- The package is a portable library run by the task host, so it is published without the program's runtime and single-file properties: a library refuses PublishSingleFile (NETSDK1099), and its RID-free
         build output, which the publish takes with NoBuild, is where the program's reference built it -->
    <MSBuild Projects="$(DbDataKitRoot)src\DbDataKit.Runner.Metadata\DbDataKit.Runner.Metadata.csproj" Targets="Publish"
             Properties="NoBuild=true;PublishDir=$(_MetadataPackageDir);SelfContained=false"
             RemoveProperties="RuntimeIdentifier;PublishSingleFile;PublishReadyToRun;PublishTrimmed;PublishAot;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;EnableCompressionInSingleFile" />
  </Target>
  <!-- ExcludeFromSingleFile: under PublishSingleFile the SDK bundles every assembly of the list into the program's executable, and the package's assemblies must stay files in its folder, where the task host loads them from -->
  <Target Name="BuiltInPackagesIntoPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="CopyBuiltInPackages" Condition="'$(UseLocalDbDataKit)' == 'true'">
    <ItemGroup>
      <_MetadataPackageFile Include="$(_MetadataPackageDir)**\*" />
      <ResolvedFileToPublish Include="@(_MetadataPackageFile)" RelativePath="builtin\dbdatakit-metadata\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
